<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\Enactive.Core\Enactive.Core.csproj" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <!-- System.Net.Mail.SmtpClient is the one in the box and Microsoft's own guidance is not to
         use it for new work: no modern authentication, and STARTTLS handling that is a footgun.
         MailKit is what that guidance points at. -->
    <PackageReference Include="MailKit" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The bounded process-output collector is an implementation detail with a limit worth pinning:
         a command's output must not decide how much memory this application uses. -->
    <InternalsVisibleTo Include="Enactive.Engine.Tests" />
  </ItemGroup>

</Project>
