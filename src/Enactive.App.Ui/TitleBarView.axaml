<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             x:Class="Enactive.App.Ui.TitleBarView">

    <!-- Every window's title bar, in one place. The client area is extended over the
         system decorations, so this strip IS the title bar: TitleBar makes the platform
         drag and double-click-to-maximise it, and the three buttons declare
         DecorationsElement so their clicks reach the handlers here rather than being
         swallowed by Windows.

         The name comes from the window's own Title, so there is still exactly one place
         a window is named. Minimise and maximise appear only on a window that can be
         resized - a modal dialog that can be minimised out from under its owner is a
         dialog you have lost. -->
    <Border Classes="titlebar" Height="34"
            chrome:WindowDecorationProperties.ElementRole="TitleBar">
        <Grid ColumnDefinitions="Auto,*,Auto">

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                        Margin="12,0,0,0" VerticalAlignment="Center">
                <!-- The Loop: the run cycle, the gap where the human decision fits, and
                     the artifact in the middle. -->
                <Viewbox Width="16" Height="16">
                    <Canvas Width="64" Height="64">
                        <Path Data="M 36.37,11.46 A 21,21 0 1 0 52.19,26.21"
                              Stroke="{DynamicResource Brand.Accent}" StrokeThickness="8"
                              StrokeLineCap="Round" />
                        <Path Data="M 49.02,15.16 L 59.27,26.25 L 46.21,30.01 Z"
                              Fill="{DynamicResource Brand.Accent}" />
                        <Ellipse Canvas.Left="25.5" Canvas.Top="25.5" Width="13" Height="13"
                                 Fill="{DynamicResource Brand.Amber}" />
                    </Canvas>
                </Viewbox>
                <TextBlock Text="{Binding $parent[Window].Title}" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="MinimiseButton" Classes="caption" ToolTip.Tip="Minimise"
                        IsVisible="{Binding $parent[Window].CanResize}"
                        chrome:WindowDecorationProperties.ElementRole="DecorationsElement">
                    <Viewbox Width="12" Height="12">
                        <Canvas Width="24" Height="24">
                            <Path Data="M 5,12 H 19" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button x:Name="MaximiseButton" Classes="caption" ToolTip.Tip="Maximise"
                        IsVisible="{Binding $parent[Window].CanResize}"
                        chrome:WindowDecorationProperties.ElementRole="DecorationsElement">
                    <Viewbox Width="12" Height="12">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="MaximiseGlyph" Data="M 6,6 H 18 V 18 H 6 Z" />
                            <Path x:Name="RestoreGlyph" IsVisible="False"
                                  Data="M 8,9 H 18 V 19 H 8 Z M 6,15 V 5 H 16" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button x:Name="CloseButton" Classes="caption close" ToolTip.Tip="Close"
                        chrome:WindowDecorationProperties.ElementRole="DecorationsElement">
                    <Viewbox Width="12" Height="12">
                        <Canvas Width="24" Height="24">
                            <Path Data="M 6,6 L 18,18 M 18,6 L 6,18" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
