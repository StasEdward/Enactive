<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Enactive.App.Ui"
        x:Class="Enactive.App.Ui.LessonsWindow"
        Title="Lessons"
        Width="720" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brand.Bg}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True">

    <!-- A workspace's lessons and rules, from its card (Plan Phase 5.2, 5.5): the list the run's Lessons tab shows. -->
    <Grid RowDefinitions="Auto,*" Margin="{Binding $parent[Window].OffScreenMargin}">
        <local:TitleBarView Grid.Row="0" />
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Margin="12,10,12,12">
            <local:LessonsView x:Name="List" />
        </ScrollViewer>
    </Grid>
</Window>
