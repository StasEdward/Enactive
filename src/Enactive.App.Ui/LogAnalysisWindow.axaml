<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Enactive.App.Ui"
        x:Class="Enactive.App.Ui.LogAnalysisWindow"
        Title="Log analysis" Width="900" Height="760" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brand.Bg}" WindowDecorations="BorderOnly" ExtendClientAreaToDecorationsHint="True">
    <Grid RowDefinitions="Auto,*" Margin="{Binding $parent[Window].OffScreenMargin}">
        <local:TitleBarView />
        <DockPanel Grid.Row="1" Margin="16">

            <!-- What was read, above the answer rather than after it. An analysis of two thirds of a
                 log is a different thing from an analysis of a log, and the difference has to be the
                 first thing on screen, not a footnote. -->
            <TextBlock DockPanel.Dock="Top" Classes="hint" x:Name="Provenance"
                       TextWrapping="Wrap" Margin="0,0,0,10" />

            <StackPanel DockPanel.Dock="Bottom" Classes="actions">
                <TextBlock Classes="hint" VerticalAlignment="Center" Margin="0,0,10,0" x:Name="Cost" />
                <Button Content="Copy" Click="OnCopy" />
                <Button Classes="primary" Content="Close" Click="OnClose" />
            </StackPanel>

            <TextBox x:Name="Answer" Classes="multiline" IsReadOnly="True"
                     AcceptsReturn="True" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
