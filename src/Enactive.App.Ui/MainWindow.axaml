<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Enactive.App.Ui.ViewModels"
        xmlns:local="using:Enactive.App.Ui"
        xmlns:sys="using:System"
        x:Class="Enactive.App.Ui.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Enactive"
        Width="1080" Height="720"
        Background="{DynamicResource Brand.Bg}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True">

    <Window.Resources>
        <GridLength x:Key="CurrentActionPanelHeight">130</GridLength>
    </Window.Resources>

    <!-- OffScreenMargin keeps a MAXIMISED window inside the screen: with the client
         area extended over the decorations, Windows would otherwise push the edges
         a few pixels past the work area. -->
    <Grid RowDefinitions="Auto,*" Margin="{Binding $parent[Window].OffScreenMargin}">

        <local:TitleBarView Grid.Row="0" />

        <!--
          Three columns, full height: the icon rail is chrome, the context column says
          WHERE you are working and how the next run is configured, and everything about
          the run itself lives in the third.
        -->
        <Grid Grid.Row="1" ColumnDefinitions="52,268,*">

        <!-- ── Icon rail ────────────────────────────────────────────────────── -->
        <Border Grid.Column="0" Classes="rail">
            <DockPanel LastChildFill="False">

                <Button DockPanel.Dock="Top" Classes="rail" Command="{Binding TimelineCommand}"
                        ToolTip.Tip="Timeline · project memory" Margin="0,10,0,0">
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <Path Data="M 7,4 V 20" />
                            <Path Data="M 7,7 A 2,2 0 1 0 7.01,7 Z M 7,12 A 2,2 0 1 0 7.01,12 Z
                                        M 7,17 A 2,2 0 1 0 7.01,17 Z" />
                            <Path Data="M 12,7 H 19 M 12,12 H 17 M 12,17 H 20" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- The template library: a saved task, run without typing a prompt. -->
                <Button DockPanel.Dock="Top" Classes="rail" Command="{Binding TemplatesCommand}"
                        ToolTip.Tip="Templates · a saved task">
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <Path Data="M 4,4 H 20 V 8 H 4 Z" />
                            <Path Data="M 4,11 H 20 V 15 H 4 Z" />
                            <Path Data="M 4,18 H 13 V 20 H 4 Z" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Schedules: the same saved task, set to run on a day and a time with nobody
                     watching. Next to Templates because it is what you reach for straight after. -->
                <Button DockPanel.Dock="Top" Classes="rail" Command="{Binding SchedulesCommand}"
                        ToolTip.Tip="Schedules · run it on a day and a time">
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <Path Data="M 4,6 H 20 V 20 H 4 Z" />
                            <Path Data="M 4,10 H 20" />
                            <Path Data="M 8,4 V 7 M 16,4 V 7" />
                            <Path Data="M 12,13 V 16 H 15" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button DockPanel.Dock="Top" Classes="rail" Command="{Binding InboxCommand}"
                        ToolTip.Tip="{Binding InboxTooltip}">
                    <Panel>
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 3,7 H 21 V 19 H 3 Z" />
                                <Path Data="M 3,7 L 12,14 L 21,7" />
                            </Canvas>
                        </Viewbox>
                        <Ellipse Width="7" Height="7" Margin="0,2,2,0"
                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Fill="{DynamicResource Brand.Accent}"
                                 IsVisible="{Binding HasUnread}" />
                    </Panel>
                </Button>

                <Button DockPanel.Dock="Top" Classes="rail" Command="{Binding LogCommand}"
                        ToolTip.Tip="Global log">
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <Path Data="M 5,5 H 19 V 19 H 5 Z" />
                            <Path Data="M 8,9 H 16 M 8,13 H 16 M 8,17 H 13" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button DockPanel.Dock="Bottom" Classes="rail" Command="{Binding SettingsCommand}"
                        ToolTip.Tip="Settings" Margin="0,0,0,10">
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <Path Data="M 12,8.8 A 3.2,3.2 0 1 0 12.01,8.8 Z" />
                            <Path Data="M 19.43,12.98
                                        C 19.47,12.66 19.5,12.33 19.5,12
                                        C 19.5,11.67 19.47,11.34 19.43,11.02
                                        L 21.54,9.37
                                        L 19.54,5.91
                                        L 17.05,6.91
                                        C 16.53,6.51 15.97,6.18 15.36,5.93
                                        L 14.98,3.28
                                        L 9.02,3.28
                                        L 8.64,5.93
                                        C 8.03,6.18 7.47,6.51 6.95,6.91
                                        L 4.46,5.91
                                        L 2.46,9.37
                                        L 4.57,11.02
                                        C 4.53,11.34 4.5,11.67 4.5,12
                                        C 4.5,12.33 4.53,12.66 4.57,12.98
                                        L 2.46,14.63
                                        L 4.46,18.09
                                        L 6.95,17.09
                                        C 7.47,17.49 8.03,17.82 8.64,18.07
                                        L 9.02,20.72
                                        L 14.98,20.72
                                        L 15.36,18.07
                                        C 15.97,17.82 16.53,17.49 17.05,17.09
                                        L 19.54,18.09
                                        L 21.54,14.63
                                        Z
                                        M 12,15.5
                                        A 3.5,3.5 0 1,1 12,8.5
                                        A 3.5,3.5 0 1,1 12,15.5" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button DockPanel.Dock="Bottom" Classes="rail" Command="{Binding EnvironmentCommand}"
                        ToolTip.Tip="Environment">
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <Path Data="M 4,5 H 20 V 15 H 4 Z" />
                            <Path Data="M 9,19 H 15 M 12,15 V 19" />
                        </Canvas>
                    </Viewbox>
                </Button>

            </DockPanel>
        </Border>

        <!-- ── Context: where you are working, and how the next run is set up ── -->
        <Border Grid.Column="1" Classes="context">
            <DockPanel LastChildFill="True">

                <!-- Where the work happens, and what has been done there - one column, no
                     switching. Change the workspace and watch the list under it change. -->
                <StackPanel DockPanel.Dock="Top" Margin="12,12,12,0" Spacing="8">
                    <TextBlock Classes="panelHeader" Text="WORKSPACE" Margin="0" />

                    <Panel>
                        <Border BorderBrush="{Binding WorkspaceMissing, Converter={x:Static local:Palette.MissingEdge}}"
                                BorderThickness="2,0,0,0" CornerRadius="0,5,5,0">
                        <!-- Live during a run. The run keeps going in the workspace it belongs to,
                             its row stays in that workspace's RUNNING block, and coming back
                             restores its feed - so leaving it is no longer losing it. -->
                        <Button Classes="wsCard" Command="{Binding ToggleSwitcherCommand}"
                                ToolTip.Tip="{Binding WorkspacePath}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="1" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding WorkspaceName}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{Binding WorkspaceMissing, Converter={x:Static local:Palette.MissingName}}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Classes="path" Text="{Binding WorkspacePath}" />
                                </StackPanel>
                                <Viewbox Grid.Column="1" Width="14" Height="14"
                                         VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 7,10 L 12,15 L 17,10" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Button>
                        </Border>

                        <!-- The switcher. Light dismiss writes IsOpen back, so clicking
                             away closes it without the view model being told twice. -->
                        <Popup IsOpen="{Binding IsSwitcherOpen, Mode=TwoWay}"
                               Placement="BottomEdgeAlignedLeft" VerticalOffset="4"
                               IsLightDismissEnabled="True">
                            <Border Classes="popup" Width="300">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="panelHeader" Text="WORKSPACES" Margin="0" />

                                    <ScrollViewer MaxHeight="300"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Workspaces}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:WorkspaceItemViewModel">
                                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                                        <!-- The edge and the fill live on a
                                                             Border, not on the Button: Fluent
                                                             repaints a button's own border and
                                                             background on hover, and neither
                                                             the marker nor "you are here" may
                                                             blink when the pointer crosses. -->
                                                        <Border Grid.Column="0"
                                                                Background="{Binding IsCurrent, Converter={x:Static local:Palette.WorkspaceFill}}"
                                                                BorderBrush="{Binding Place, Converter={x:Static local:Palette.WorkspaceEdge}}"
                                                                BorderThickness="2,0,0,0"
                                                                CornerRadius="0,4,4,0"
                                                                Margin="0,0,0,4">
                                                        <Button Classes="wsRow"
                                                                Command="{Binding SwitchCommand}">
                                                            <StackPanel Spacing="1">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="12.5" FontWeight="SemiBold"
                                                                           Foreground="{Binding Exists, Converter={x:Static local:Palette.WorkspaceName}}"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Detail}"
                                                                           FontSize="11"
                                                                           Foreground="{Binding Exists, Converter={x:Static local:Palette.WorkspaceDetail}}"
                                                                           FontFamily="Consolas, Menlo, monospace"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="PrefixCharacterEllipsis" />
                                                            </StackPanel>
                                                        </Button>
                                                        </Border>
                                                        <Button Grid.Column="1" Classes="rowIcon"
                                                                Command="{Binding RenameCommand}"
                                                                ToolTip.Tip="Rename. What Enactive calls it — the folder is not touched.">
                                                            <Viewbox Width="16" Height="16">
                                                                <Canvas Width="24" Height="24">
                                                                    <Path Data="M 4,20 L 4,16 L 15.5,4.5 L 19.5,8.5 L 8,20 Z" />
                                                                    <Path Data="M 13.5,6.5 L 17.5,10.5" />
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                        <Button Grid.Column="2" Classes="rowIcon destructive"
                                                                Command="{Binding ForgetCommand}"
                                                                ToolTip.Tip="Forget this workspace. The folder and its history are left where they are.">
                                                            <Viewbox Width="15" Height="15">
                                                                <Canvas Width="24" Height="24">
                                                                    <Path Data="M 6,6 L 18,18 M 18,6 L 6,18" />
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <Button Content="Add folder…" FontSize="12"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding AddWorkspaceCommand}" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Panel>

                    <TextBlock IsVisible="{Binding WorkspaceMissing}" FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brand.Danger}"
                               Text="This folder is not on disk. Nothing will run here until you pick another one." />


                    <TextBlock Classes="hint" Text="{Binding EnvironmentSummary}" />
                </StackPanel>

                <!-- The line between "where" and "what happened there". -->
                <Border DockPanel.Dock="Top" Height="1" Margin="12,12,12,0"
                        Background="{DynamicResource Brand.Line}" />

                <Grid DockPanel.Dock="Top" Margin="12,10,12,6" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="panelHeader" Text="RUNS" Margin="0"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Refresh" FontSize="11" Padding="8,1"
                            IsEnabled="{Binding IsColumnIdle}"
                            Command="{Binding Runs.RefreshCommand}" />
                </Grid>

                <!-- What is happening RIGHT NOW. Above everything, because the column's first job
                     is the present tense and it used to have nothing to say about it: a run is
                     written to the store when it ENDS, so between Run and the end it appeared
                     nowhere but the middle column. Start a run, open an older one to compare, and
                     the run you had just started was findable in no list at all.

                     NOT frozen with the rest of the column. Everything else here is disabled while
                     a run is on - that is the point - but this row exists to be pressed while a run
                     is on, and a greyed-out way back is no way back. -->
                <StackPanel DockPanel.Dock="Top" Margin="12,0,12,8"
                            IsVisible="{Binding Runs.HasRunning}">
                    <TextBlock Classes="panelHeader" Text="RUNNING" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Runs.Running}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LiveRunViewModel">
                                <!-- The same shape as an UNFINISHED row: a card, and a small button
                                     for the one thing you can do with it. Open is absent on a
                                     background run rather than disabled - there is no live view to
                                     go to, and an offer that cannot be taken is not an offer. -->
                                <Border Classes="card" BorderBrush="{DynamicResource Brand.Accent}"
                                        ToolTip.Tip="{Binding Tooltip}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Classes="cardTitle" Text="{Binding Title}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="cardMeta" Text="{Binding Meta}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Open" FontSize="11" Padding="8,1"
                                                VerticalAlignment="Center" Margin="6,0,0,0"
                                                IsVisible="{Binding CanOpen}"
                                                Command="{Binding OpenCommand}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- The filter decides the set, and the button destroys exactly what is on screen.
                     Removing runs one at a time was the only way to remove any, and a workspace
                     used for a few days had 37 of them - most of them repeat attempts at one task.
                     The button carries the COUNT so it says how much it takes before it is pressed,
                     not in a dialog afterwards. -->
                <Grid DockPanel.Dock="Top" Margin="12,0,12,6" ColumnDefinitions="*,Auto"
                      IsEnabled="{Binding IsColumnIdle}">
                    <ComboBox Grid.Column="0" FontSize="11" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Runs.FilterNames}"
                              SelectedIndex="{Binding Runs.FilterIndex, Mode=TwoWay}"
                              ToolTip.Tip="Which runs the list shows" />
                    <Button Grid.Column="1" Margin="6,0,0,0" FontSize="11" Padding="8,1"
                            Classes="destructive"
                            Content="{Binding Runs.DeleteShownLabel}"
                            IsEnabled="{Binding Runs.CanDeleteShown}"
                            Command="{Binding Runs.DeleteShownCommand}"
                            ToolTip.Tip="Forget every run listed below. This cannot be undone." />
                </Grid>

                <!-- Runs nobody knows the end of: the process they were in went away before they
                     finished. Above the history rather than in it, because this is not a record of
                     something that happened - it is an offer to carry on - and a killed run usually
                     wrote no record at all. Nothing shows when there are none, which is normally. -->
                <StackPanel DockPanel.Dock="Top" Margin="12,0,12,8"
                            IsEnabled="{Binding IsIdle}"
                            IsVisible="{Binding Runs.HasResumable}">
                    <TextBlock Classes="panelHeader" Text="UNFINISHED" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Runs.Resumable}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ResumableRunViewModel">
                                <Border Classes="card" BorderBrush="{DynamicResource Brand.Amber}"
                                        ToolTip.Tip="{Binding Tooltip}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Classes="cardTitle" Text="{Binding Title}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="cardMeta" Text="{Binding Meta}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Resume" FontSize="11" Padding="8,1"
                                                VerticalAlignment="Center" Margin="6,0,0,0"
                                                Command="{Binding ResumeCommand}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Classes="hint" Margin="12,6,12,0"
                           Text="{Binding Runs.Status}" />

                <!-- Picking one opens it read-only over the live run, which keeps running
                     underneath, and Back returns to it - as does Open on the RUNNING row above,
                     which is the affordance that makes reading history during a run safe to offer.
                     Live while a run is on, unlike the controls around it: reading what an earlier
                     attempt did is most useful precisely while you are waiting on this one. -->
                <ListBox Classes="cards" Margin="12,0,12,0"
                         ItemsSource="{Binding Runs.Items}"
                         SelectedItem="{Binding Runs.Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:RunListItemViewModel">
                            <Border Classes="card" BorderBrush="{Binding Record.Status, Converter={x:Static local:Palette.RunEdge}}"
                                    ToolTip.Tip="{Binding Tooltip}" Margin="{Binding IsLead, Converter={x:Static local:Palette.AttemptMargin}}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- The attempt count, on a task that took more than one go.
                                         Twelve tries at one task used to be twelve rows and read as
                                         twelve pieces of work; this is one row that says twelve.
                                         Pressing it lists the older attempts underneath. -->
                                    <Button Grid.Column="0" Classes="attempts"
                                            IsVisible="{Binding HasAttempts}"
                                            Command="{Binding ToggleCommand}"
                                            VerticalAlignment="Center" Margin="0,0,8,0"
                                            ToolTip.Tip="Show the other attempts at this task">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <TextBlock Text="{Binding Chevron}" FontSize="9"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding AttemptsLabel}" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Grid.Column="1">
                                        <!-- NoWrap as well as trimming: trimming alone cuts a long
                                             line, and a title with a newline in it still became four.
                                             The title is one line now; this is what keeps it one. -->
                                        <TextBlock Classes="cardTitle" Text="{Binding Title}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="cardMeta" Text="{Binding Meta}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <!-- Visible, like the row actions in every other list here.
                                         Hiding it until hover would leave an invisible button that
                                         still takes the click - a trap on a delete, and the reason
                                         to make it discoverable instead is that the confirmation is
                                         what actually guards it. -->
                                    <Button Grid.Column="2" Classes="rowIcon destructive"
                                            VerticalAlignment="Top" Margin="6,0,0,0"
                                            Command="{Binding RemoveCommand}"
                                            ToolTip.Tip="Delete this run from the history">
                                        <Viewbox Width="15" Height="15">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M 5,7 L 19,7 M 10,7 L 10,5 L 14,5 L 14,7 M 7,7 L 8,20 L 16,20 L 17,7 M 10.5,10 L 10.5,17 M 13.5,10 L 13.5,17" />
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </DockPanel>
        </Border>

        <!-- ── Main: the command bar and the run ────────────────────────────── -->
        <DockPanel Grid.Column="2" LastChildFill="True">

            <StackPanel DockPanel.Dock="Top" Height="118" Margin="16,12,16,10" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ItemsControl ItemsSource="{Binding Verbs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:VerbChipViewModel">
                                <Button Content="{Binding Verb}" Command="{Binding Command}"
                                        FontSize="11" Padding="8,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Ctrl+K to focus · Enter to run · Ctrl+Enter = newline"
                               Classes="hint" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <DockPanel LastChildFill="True" Height="88">

                    <!-- How the next run behaves, beside the box that starts it. It used to be a
                         NEXT RUN panel on the far side of the window: three controls that decide
                         what the Run button does, placed where you cannot see them while pressing
                         it. Declared first because a DockPanel fills from the outside in - this
                         block is the far right. -->
                    <StackPanel DockPanel.Dock="Right" Width="252" Spacing="4"
                                VerticalAlignment="Center">
                        <Grid ColumnDefinitions="Auto,*">
                            <ComboBox Grid.Column="0" Width="118" FontSize="11"
                                      ItemsSource="{Binding WorkerRoles}"
                                      SelectedIndex="{Binding SelectedWorkerIndex, Mode=TwoWay}"
                                      ToolTip.Tip="Which role the worker takes" />
                            <CheckBox Grid.Column="1" Content="Stage changes" FontSize="11"
                                      Margin="10,0,0,0" VerticalAlignment="Center"
                                      IsChecked="{Binding StageChanges}" IsEnabled="{Binding IsIdle}"
                                      ToolTip.Tip="Write changes to a staging area and review the diff before applying." />
                        </Grid>
                        <!-- The label names what the slider is set to, so it belongs ON the
                             slider, not floating above it. A Slider carries its own vertical
                             padding around the track; the negative margin takes it back. -->
                        <TextBlock Text="{Binding AutonomyLabel}" Foreground="{Binding AutonomyTier, Converter={x:Static local:Palette.Autonomy}}"
                                   FontSize="11" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                   ToolTip.Tip="{Binding AutonomyLabel}" />
                        <!-- As many positions as there are tiers (AutonomyTiers): a literal 3 would hide a tier added there. -->
                        <Slider Minimum="0" Maximum="{Binding HighestAutonomyLevel}" TickFrequency="1" IsSnapToTickEnabled="True"
                                Margin="0,-9,0,-9"
                                Value="{Binding AutonomyLevel, Mode=TwoWay}" IsEnabled="{Binding IsIdle}" />
                    </StackPanel>

                    <Border DockPanel.Dock="Right" Width="1" Margin="12,2"
                            Background="{DynamicResource Brand.Line}" />

                    <!-- Both ways of starting are here, beside the box you typed into. Which one
                         you pressed is what decides where the run goes - it used to be a checkbox
                         in the panel on the left, so Run did two different things depending on a
                         box ticked ten minutes ago and scrolled out of sight. -->
                    <StackPanel DockPanel.Dock="Right" Width="156" Spacing="6" VerticalAlignment="Center"
                                Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Classes="go" Content="Run" Width="86"
                                    ToolTip.Tip="{Binding RunTip}"
                                    Command="{Binding RunCommand}" />
                            <!-- Stop throws away work that is half done, which is the same act as
                                 Reject, and Danger is the palette's colour for it. Outlined, not
                                 filled: it must be findable without competing with Run. -->
                            <Button Classes="destructive" Content="Stop" Width="64"
                                    Command="{Binding StopCommand}" />
                        </StackPanel>
                        <Button Classes="goSoft" Content="Run in background"
                                HorizontalAlignment="Stretch"
                                Command="{Binding RunBackgroundCommand}"
                                ToolTip.Tip="Runs it headless: the window stays free and it reports back to the Inbox when it is done." />
                    </StackPanel>
                    <TextBox x:Name="InputBox"
                             Text="{Binding InputText}"
                             IsEnabled="{Binding IsIdle}"
                             PlaceholderText="What do you want to accomplish?"
                             AcceptsReturn="True" Height="88" TextWrapping="Wrap"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </DockPanel>
            </StackPanel>

            <!-- The live run and a past one occupy the same space: reading history does
                 not shrink the run you are watching, and a new run brings you back. -->
            <Grid ColumnDefinitions="*,300">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="{StaticResource CurrentActionPanelHeight}" />
                </Grid.RowDefinitions>

            <DockPanel Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsViewingLive}" LastChildFill="True">

            <!-- ── The task ────────────────────────────────────────────────────
                 The command bar clears when a run starts, so without this the only
                 place to read what you asked for was the log. The pill states the
                 phase once, here, instead of being repeated down the right column.
            -->
            <!-- Keep the task slot even before selection. 441 = input's right controls:
                 8 gap + 156 buttons + 25 separator/margins + 252 role settings. -->
            <Border DockPanel.Dock="Top" Classes="taskHeader" Height="110" ClipToBounds="True">
                <Grid ColumnDefinitions="*,441" IsVisible="{Binding HasTask}">
                    <StackPanel Grid.Column="0" Spacing="2" ClipToBounds="True">
                        <TextBlock Text="{Binding TaskTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                        <!-- The request, readable and takeable. It was one line with an
                             ellipsis and the rest on a hover; a hover is not reading, and a
                             TextBlock cannot be selected with a mouse. Three lines, fixed, so
                             the run underneath does not move when the request is long. -->
                        <TextBox Classes="taskIntent" Text="{Binding TaskIntent}" />
                    </StackPanel>
                    <Border Grid.Column="1" Classes="pill" HorizontalAlignment="Right" Background="{Binding StatusPhase, Converter={x:Static local:Palette.PhaseFill}}">
                        <TextBlock Text="{Binding StatusPhase}"
                                   Foreground="{Binding StatusPhase, Converter={x:Static local:Palette.PhaseText}}" />
                    </Border>
                </Grid>
            </Border>

            <!-- ── Three views of the same run ─────────────────────────────────
                 Artifacts used to share the right column with the status; a run
                 that writes a dozen files needs the width, and the status needs
                 to stay put while you read them.
            -->
            <Border DockPanel.Dock="Top" Height="36" Padding="16,0"
                    BorderBrush="{DynamicResource Brand.Line}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <Button Classes="tab" Classes.on="{Binding IsExecutionTab}"
                            Content="Execution" Command="{Binding ShowExecutionCommand}" />
                    <Button Classes="tab" Classes.on="{Binding IsArtifactsTab}"
                            Content="{Binding ArtifactsTabLabel}" Command="{Binding ShowArtifactsCommand}" />
                    <Button Classes="tab" Classes.on="{Binding IsLogTab}"
                            Content="Log" Command="{Binding ShowLogCommand}" />
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,300">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="{StaticResource CurrentActionPanelHeight}" />
                </Grid.RowDefinitions>

                <Panel Grid.Column="0">

                    <!-- Execution: the plan-step feed. -->
                    <ScrollViewer IsVisible="{Binding IsExecutionTab}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Steps}" Margin="16,12,10,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StepCardViewModel">
                                    <local:StepCardView />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Artifacts: what the run wrote, and what is waiting on you. -->
                    <ScrollViewer IsVisible="{Binding IsArtifactsTab}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Artifacts}" Margin="16,12,10,12">
                            <ItemsControl.DataTemplates>

                                <!-- A file written straight to disk. -->
                                <DataTemplate DataType="vm:ArtifactItemViewModel" x:DataType="vm:ArtifactItemViewModel">
                                    <Border Background="{DynamicResource Brand.CardFill}" CornerRadius="4"
                                            Padding="10" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,10,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RelativePath}" TextWrapping="Wrap"
                                                           FontFamily="Consolas, Menlo, monospace" FontSize="12" />
                                                <TextBlock Classes="hint" Text="{Binding Status}" FontSize="11" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                        VerticalAlignment="Center">
                                                <Button Content="Review" Command="{Binding ReviewCommand}"
                                                        FontSize="11" Padding="8,2" />
                                                <Button Content="{Binding ActionLabel}" Command="{Binding UndoCommand}"
                                                        Foreground="{DynamicResource Brand.Danger}"
                                                        FontSize="11" Padding="8,2" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>

                                <!-- A change waiting for apply or reject, with its diff. Amber down
                                     the edge: it is blocked on a person, not an error. -->
                                <DataTemplate DataType="vm:StagedChangeViewModel" x:DataType="vm:StagedChangeViewModel">
                                    <Border Background="{DynamicResource Brand.CardFill}"
                                            BorderBrush="{DynamicResource Brand.Amber}"
                                            BorderThickness="2,0,0,0" CornerRadius="4"
                                            Padding="10" Margin="0,0,0,6">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,10,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RelativePath}" TextWrapping="Wrap"
                                                               FontFamily="Consolas, Menlo, monospace" FontSize="12" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Classes="hint" Text="{Binding Tag}" FontSize="11" />
                                                        <TextBlock Text="{Binding Status}" Foreground="{Binding State, Converter={x:Static local:Palette.Change}}"
                                                                   FontSize="11" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                            VerticalAlignment="Center">
                                                    <Button Content="Diff" Command="{Binding DiffCommand}"
                                                            FontSize="11" Padding="8,2" />
                                                    <Button Content="Apply" Command="{Binding ApplyCommand}"
                                                            FontSize="11" Padding="8,2" />
                                                    <Button Content="Reject" Command="{Binding RejectCommand}"
                                                            FontSize="11" Padding="8,2" />
                                                </StackPanel>
                                            </Grid>
                                            <Border IsVisible="{Binding IsDiffVisible}"
                                                    Background="{DynamicResource Brand.Scrim}"
                                                    CornerRadius="3" Padding="6" Margin="0,8,0,0"
                                                    MaxHeight="320">
                                                <ScrollViewer>
                                                    <ItemsControl ItemsSource="{Binding Diff}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:DiffLineViewModel">
                                                                <TextBlock Text="{Binding Text}"
                                                                           Foreground="{Binding Kind, Converter={x:Static local:Palette.DiffLine}}"
                                                                           FontFamily="Consolas, Menlo, monospace"
                                                                           FontSize="11" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>

                            </ItemsControl.DataTemplates>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Log: this run only. The whole log, across every run and with
                         the filters, is still its own window on the rail. -->
                    <DockPanel IsVisible="{Binding IsLogTab}" Margin="16,10,10,12">
                        <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,6"
                                   Text="{Binding RunLog.Header}" />
                        <ListBox ItemsSource="{Binding RunLog.Rows}" Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:LogRow">
                                    <TextBlock Text="{Binding Line}"
                                               Foreground="{Binding Entry.Level, Converter={x:Static local:Palette.LogLevel}}"
                                               FontFamily="Consolas, Menlo, monospace"
                                               FontSize="12"
                                               TextWrapping="NoWrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                </Panel>

                <!-- ── Status: where the run is, and what it is waiting on ─────
                     Stays put whichever tab is showing, because a decision that
                     needs answering must not be a tab away.
                -->
                <Grid Grid.Column="1" Grid.RowSpan="2" RowDefinitions="*,Auto" Margin="6,12,16,12">
                <ScrollViewer Grid.Row="0" Margin="0,0,0,12"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="panelHeader" Text="AI STATUS" Margin="0" />

                        <!-- Four tiles, two by two: a 300px column cannot hold four across
                             and still show a number. Only counts the app actually holds. -->
                        <Grid ColumnDefinitions="*,6,*" RowDefinitions="Auto,6,Auto">
                            <Border Grid.Row="0" Grid.Column="0" Classes="tile">
                                <StackPanel>
                                    <TextBlock Classes="tileValue" Text="{Binding ArtifactCountText}" />
                                    <TextBlock Classes="tileLabel" Text="ARTIFACTS" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" Classes="tile">
                                <StackPanel>
                                    <TextBlock Classes="tileValue" Text="{Binding ToolCallsText}" />
                                    <TextBlock Classes="tileLabel" Text="TOOL CALLS" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="0" Classes="tile"
                                    ToolTip.Tip="{Binding TokensDetail}">
                                <StackPanel>
                                    <TextBlock Classes="tileValue" Text="{Binding TokensText}" />
                                    <TextBlock Classes="tileLabel" Text="TOKENS" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="2" Classes="tile">
                                <StackPanel>
                                    <TextBlock Classes="tileValue" Text="{Binding StatusElapsed}" />
                                    <TextBlock Classes="tileLabel" Text="ELAPSED" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Which model actually served each phase. Read from the run's own Routed
                             events, not from the bindings: the settings say what is bound, this
                             says what was used. -->
                        <StackPanel Spacing="2" IsVisible="{Binding Routing.HasAny}"
                                    Margin="0,6,0,0">
                            <TextBlock Classes="panelHeader" Text="ROUTING" Margin="0" />
                            <ItemsControl ItemsSource="{Binding Routing.Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RoutingRow">
                                        <Grid ColumnDefinitions="52,*" Margin="0,1">
                                            <TextBlock Grid.Column="0" Classes="routingPhase"
                                                       Text="{Binding Phase}" />
                                            <TextBlock Grid.Column="1" Classes="routing"
                                                       Text="{Binding Model}"
                                                       ToolTip.Tip="{Binding Model}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Who did the work, not just how much of it there was. Green is this
                             machine, blue was bought. The percentage is of TOKENS; the call count
                             is beside it because the two can disagree, and when they do that is
                             the interesting part. -->
                        <StackPanel Spacing="2" IsVisible="{Binding ModelWork.HasAny}"
                                    Margin="0,6,0,0">
                            <TextBlock Classes="panelHeader" Text="WHERE IT RAN" Margin="0" />
                            <ItemsControl ItemsSource="{Binding ModelWork.Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ModelWorkRow">
                                        <Grid ColumnDefinitions="52,*" Margin="0,1">
                                            <TextBlock Grid.Column="0" Classes="routingPhase"
                                                       Text="{Binding Label}"
                                                       Foreground="{Binding Reach, Converter={x:Static local:Palette.Reach}}" />
                                            <TextBlock Grid.Column="1" Classes="routing"
                                                       Text="{Binding Detail}"
                                                       ToolTip.Tip="{Binding Detail}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Classes="hint" Text="{Binding StatusProgress}" FontSize="12" />

                        <Border Background="{Binding Agent, Converter={x:Static local:Palette.Agent}}" IsVisible="{Binding IsAgentVisible}"
                                Classes="pill" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding AgentBadge}"
                                       Foreground="{DynamicResource Brand.Text}" />
                        </Border>

                        <!-- A decision card means the run is BLOCKED waiting on the user -
                             caution, not action - so it is amber, not ember. Ember belongs
                             to the Allow button. -->
                        <Border IsVisible="{Binding IsDecisionVisible}"
                                Background="{DynamicResource Brand.DecisionFill}"
                                BorderBrush="{DynamicResource Brand.DecisionBorder}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="USER DECISION REQUIRED" FontWeight="Bold" />
                                <TextBlock Text="{Binding DecisionText}" TextWrapping="Wrap"
                                           Margin="0,4,0,0" FontSize="12" />

                                <!-- The COMPLETE action, never the shortened one. A command is
                                     approved by reading it, so it is monospaced, keeps its line
                                     breaks, and scrolls instead of being cut off. -->
                                <Border IsVisible="{Binding HasDecisionDetail}"
                                        Background="{DynamicResource Brand.InputFill}"
                                        CornerRadius="4" Padding="8" Margin="0,8,0,0">
                                    <ScrollViewer MaxHeight="220"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto">
                                        <SelectableTextBlock Text="{Binding DecisionDetail}"
                                                             FontFamily="Consolas, Menlo, monospace"
                                                             FontSize="12" />
                                    </ScrollViewer>
                                </Border>

                                <ItemsControl ItemsSource="{Binding DecisionOptions}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DecisionOptionViewModel">
                                            <Button Content="{Binding Label}" Command="{Binding Command}"
                                                    Margin="0,0,8,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
                    <Border Grid.Row="1" Background="{DynamicResource Brand.CardFill}" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="panelHeader" Text="MODEL PERFORMANCE" Margin="0" />
                            <TextBlock Classes="hint" Text="This session · completed requests" FontSize="11" />
                            <TextBlock Classes="hint" Text="Statistics appear after a model responds."
                                       TextWrapping="Wrap" IsVisible="{Binding !Performance.Rows.Count}" />
                            <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Performance.Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ModelPerformanceRow">
                                            <Border BorderBrush="{DynamicResource Brand.InputFill}" BorderThickness="0,1,0,0"
                                                    Padding="0,10,0,8" ToolTip.Tip="{Binding Explanation}">
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="{Binding Model}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Classes="hint" Text="{Binding Provider}" FontSize="11" />
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="hint" Text="{Binding SpeedLabel}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Speed}" FontSize="11.5" FontWeight="SemiBold" />
                                                    </Grid>
                                                    <TextBlock Classes="hint" Text="{Binding Times}" FontSize="11" TextWrapping="Wrap" />
                                                    <TextBlock Classes="hint" Text="{Binding Tokens}" FontSize="11" TextWrapping="Wrap" />
                                                    <TextBlock Classes="hint" Text="{Binding Cache}" FontSize="11" TextWrapping="Wrap" />
                                                    <TextBlock Classes="hint" Text="{Binding First}" FontSize="11" />
                                                    <TextBlock Classes="hint" Text="{Binding Requests}" FontSize="11" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
            </DockPanel>

            <!-- ── A past run, read-only ───────────────────────────────────────
                 Same frame as the live one - header, tabs, status column - because
                 it is the same thing at a different time. The tabs differ because
                 the content does: no Execution, because a stored event is (when,
                 kind, summary) and the step number the cards sort by is not
                 recorded; no Log, because the hub only holds this session.
            -->
            <DockPanel Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsViewingPast}" LastChildFill="True">

                <Border DockPanel.Dock="Top" Classes="taskHeader" Height="110" ClipToBounds="True">
                    <Grid ColumnDefinitions="*,441">
                      <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ClipToBounds="True">
                        <Button Grid.Column="0" Content="← Back" FontSize="11" Padding="8,2"
                                VerticalAlignment="Center"
                                Command="{Binding BackToLiveCommand}"
                                ToolTip.Tip="Back to the current run" />
                        <StackPanel Grid.Column="1" Spacing="2" Margin="12,0">
                            <TextBlock Text="{Binding PastRun.Title}" FontSize="15" FontWeight="SemiBold"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <!-- What was asked for. It used to BE the title, four paragraphs of it;
                                 it belongs here, on one line, with the whole thing in the tooltip. -->
                            <!-- The same as the live header above, and for the same reasons:
                                 a finished run's request is the one most likely to be copied,
                                 into the command bar or into a message about what went wrong. -->
                            <TextBox Classes="taskIntent" FontSize="11"
                                     Text="{Binding PastRun.Request}"
                                     IsVisible="{Binding PastRun.HasSubtitle}" />
                            <TextBlock Classes="hint" Text="{Binding PastRun.Meta}" FontSize="11"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding PastRun.Meta}" />
                        </StackPanel>
                      </Grid>
                        <!-- The attempt label used to sit BESIDE these buttons, on their left. It
                             varies in length ("attempt 2 of 3" vs. "attempt 15 of 15") and comes
                             and goes entirely (absent on a run that was never retried), and an
                             Auto column sized to its content shifted the buttons left or right
                             every time it did - the one thing a button's position should not do
                             while somebody is aiming at it. Fixed-width buttons on their own row,
                             the label on a second row below where its length changes nothing. -->
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Grid ColumnDefinitions="118,8,118,8,*" Height="32">
                                <!-- Retry repeats THIS run exactly; Run again re-resolves the
                                     template as it stands now. Both are new attempts at the same
                                     task. -->
                                <Button Grid.Column="0" Classes="go" Content="Retry" Width="118" Padding="16,5"
                                        Command="{Binding PastRun.RetryCommand}"
                                        IsVisible="{Binding PastRun.CanRetry}"
                                        ToolTip.Tip="Run this again, exactly as it was" />
                                <Button Grid.Column="2" Classes="goSoft" Content="Run again" Width="118" Padding="16,5"
                                        Command="{Binding PastRun.RunAgainCommand}"
                                        IsVisible="{Binding PastRun.CanRunAgain}"
                                        ToolTip.Tip="{Binding PastRun.RunAgainTooltip}" />

                                <Border Grid.Column="4" Classes="pill" Width="124" Height="30" HorizontalAlignment="Right" Background="{Binding PastRun.Status, Converter={x:Static local:Palette.PhaseFill}}">
                                    <TextBlock Text="{Binding PastRun.Status}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{Binding PastRun.Status, Converter={x:Static local:Palette.PhaseText}}" />
                                </Border>
                            </Grid>

                            <!-- Which attempt of its task this is. Absent when it is the only one:
                                 "attempt 1 of 1" is noise on every run that was never retried. -->
                            <!-- Keep this row even when the attempt label is hidden, so the
                                 vertically centred action block always has the same height. -->
                            <Grid Height="16">
                                <TextBlock Classes="hint" Text="{Binding PastRun.AttemptLabel}"
                                           FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           IsVisible="{Binding PastRun.HasAttempts}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border DockPanel.Dock="Top" Height="36" Padding="16,0"
                        BorderBrush="{DynamicResource Brand.Line}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Button Classes="tab" Classes.on="{Binding PastRun.IsExecutionTab}"
                                Content="Execution" Command="{Binding PastRun.ShowExecutionCommand}" />
                        <Button Classes="tab" Classes.on="{Binding PastRun.IsArtifactsTab}"
                                Content="{Binding PastRun.ArtifactsTabLabel}"
                                Command="{Binding PastRun.ShowArtifactsCommand}" />
                        <Button Classes="tab" Classes.on="{Binding PastRun.IsTimelineTab}"
                                Content="Timeline" Command="{Binding PastRun.ShowTimelineCommand}" />
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,300">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="{StaticResource CurrentActionPanelHeight}" />
                    </Grid.RowDefinitions>

                    <Panel Grid.Column="0">

                        <!-- Execution: the plan's steps, rebuilt from the record and read the
                             way they read while the run was happening. -->
                        <ScrollViewer IsVisible="{Binding PastRun.IsExecutionTab}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,12,10,12">
                                <TextBlock Classes="hint" TextWrapping="Wrap"
                                           IsVisible="{Binding PastRun.HasNoSteps}"
                                           Text="{Binding PastRun.NoStepsReason}" />
                                <ItemsControl ItemsSource="{Binding PastRun.Steps}"
                                              IsVisible="{Binding PastRun.HasSteps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StepCardViewModel">
                                            <local:StepCardView />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Timeline: everything that was recorded, in order, with the assistant's
                             streamed reply folded back into one note per burst - including the
                             events that belong to the run rather than to any step. -->
                        <ScrollViewer IsVisible="{Binding PastRun.IsTimelineTab}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,12,10,12" Spacing="6">
                                <!-- What was put to a person, above the run that put it there:
                                     "what did it ask me" is why an old run gets opened. -->
                                <StackPanel Spacing="6" IsVisible="{Binding PastRun.HasDecisions}"
                                            Margin="0,0,0,6">
                                    <TextBlock Classes="panelHeader" Text="DECISIONS" Margin="0" />
                                    <ItemsControl ItemsSource="{Binding PastRun.Decisions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="sys:String">
                                                <Border Background="{DynamicResource Brand.CardFill}"
                                                        BorderBrush="{DynamicResource Brand.Amber}"
                                                        BorderThickness="2,0,0,0" CornerRadius="4"
                                                        Padding="10" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource Brand.TextBody}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Classes="panelHeader" Text="TIMELINE" Margin="0" />
                                </StackPanel>

                            <ItemsControl ItemsSource="{Binding PastRun.Events}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RunEventViewModel">
                                        <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,1">
                                            <TextBlock Grid.Column="0" Text="{Binding When}"
                                                       FontFamily="Consolas, Menlo, monospace" FontSize="11"
                                                       Foreground="{DynamicResource Brand.TextFaint}"
                                                       Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Kind}"
                                                       FontSize="11" Width="130"
                                                       Foreground="{DynamicResource Brand.TextMuted}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Summary}"
                                                       Foreground="{Binding Kind, Converter={x:Static local:Palette.TimelineKind}}"
                                                       FontSize="12" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Artifacts: what it left behind. Named, not offered - Review and Undo
                             belong to the run that is happening, not to one from last Tuesday. -->
                        <ScrollViewer IsVisible="{Binding PastRun.IsArtifactsTab}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,12,10,12" Spacing="6">
                                <TextBlock Classes="hint" IsVisible="{Binding PastRun.HasNoArtifacts}"
                                           Text="This run wrote nothing." />
                                <!-- Open is safe at any age. The second button is Delete, not Undo:
                                     it removes the file as it is on disk now, which for a run this
                                     old is not the version the run wrote. -->
                                <ItemsControl ItemsSource="{Binding PastRun.Artifacts}"
                                              IsVisible="{Binding PastRun.HasArtifacts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ArtifactItemViewModel">
                                            <Border Background="{DynamicResource Brand.CardFill}"
                                                    CornerRadius="4" Padding="10" Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="2"
                                                                Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RelativePath}" TextWrapping="Wrap"
                                                                   FontFamily="Consolas, Menlo, monospace"
                                                                   FontSize="12" />
                                                        <TextBlock Classes="hint" Text="{Binding Status}" FontSize="11" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                                VerticalAlignment="Center">
                                                        <Button Content="Review" Command="{Binding ReviewCommand}"
                                                                FontSize="11" Padding="8,2" />
                                                        <Button Content="Delete" Command="{Binding UndoCommand}"
                                                                Foreground="{DynamicResource Brand.Danger}"
                                                                FontSize="11" Padding="8,2" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                    </Panel>

                    <!-- The same column the live run has, off what was recorded. -->
                    <ScrollViewer Grid.Column="1" Grid.RowSpan="2" Margin="6,12,16,12"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="panelHeader" Text="THIS RUN" Margin="0" />
                            <TextBlock Classes="hint" Text="{Binding PastRun.StepsText}" FontSize="12" />

                            <!-- Four tiles, two by two: a 300px column cannot hold four across
                                 and still show a number. Only counts the app actually holds. -->
                            <Grid ColumnDefinitions="*,6,*" RowDefinitions="Auto,6,Auto">
                                <Border Grid.Row="0" Grid.Column="0" Classes="tile">
                                    <StackPanel>
                                        <TextBlock Classes="tileValue" Text="{Binding PastRun.ArtifactCountText}" />
                                        <TextBlock Classes="tileLabel" Text="ARTIFACTS" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="2" Classes="tile">
                                    <StackPanel>
                                        <TextBlock Classes="tileValue" Text="{Binding PastRun.ToolCallsText}" />
                                        <TextBlock Classes="tileLabel" Text="TOOL CALLS" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="0" Classes="tile"
                                        ToolTip.Tip="{Binding PastRun.TokensDetail}">
                                    <StackPanel>
                                        <TextBlock Classes="tileValue" Text="{Binding PastRun.TokensText}" />
                                        <TextBlock Classes="tileLabel" Text="TOKENS" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="2" Classes="tile">
                                    <StackPanel>
                                        <TextBlock Classes="tileValue" Text="{Binding PastRun.ElapsedText}" />
                                        <TextBlock Classes="tileLabel" Text="ELAPSED" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Which model actually served each phase. Read from the run's own Routed
                                 events, not from the bindings: the settings say what is bound, this
                                 says what was used. -->
                            <StackPanel Spacing="2" IsVisible="{Binding PastRun.Routing.HasAny}"
                                        Margin="0,6,0,0">
                                <TextBlock Classes="panelHeader" Text="ROUTING" Margin="0" />
                                <ItemsControl ItemsSource="{Binding PastRun.Routing.Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RoutingRow">
                                            <Grid ColumnDefinitions="52,*" Margin="0,1">
                                                <TextBlock Grid.Column="0" Classes="routingPhase"
                                                           Text="{Binding Phase}" />
                                                <TextBlock Grid.Column="1" Classes="routing"
                                                           Text="{Binding Model}"
                                                           ToolTip.Tip="{Binding Model}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- The same split as the live panel. On a past run this is where the
                                 routing changes actually get judged: it is the only place "before
                                 and after I rebound the models" can be compared. A run recorded
                                 before this was kept has no rows rather than zeroed ones. -->
                            <StackPanel Spacing="2" IsVisible="{Binding PastRun.ModelWork.HasAny}"
                                        Margin="0,6,0,0">
                                <TextBlock Classes="panelHeader" Text="WHERE IT RAN" Margin="0" />
                                <ItemsControl ItemsSource="{Binding PastRun.ModelWork.Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ModelWorkRow">
                                            <Grid ColumnDefinitions="52,*" Margin="0,1">
                                                <TextBlock Grid.Column="0" Classes="routingPhase"
                                                           Text="{Binding Label}"
                                                           Foreground="{Binding Reach, Converter={x:Static local:Palette.Reach}}" />
                                                <TextBlock Grid.Column="1" Classes="routing"
                                                           Text="{Binding Detail}"
                                                           ToolTip.Tip="{Binding Detail}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- What it was allowed to do. Half of "why did it do that" is
                                 answered here, and the slider on screen today is not it. -->
                            <StackPanel Spacing="3" IsVisible="{Binding PastRun.HasSettings}"
                                        Margin="0,6,0,0">
                                <TextBlock Classes="panelHeader" Text="RAN AS" Margin="0" />
                                <TextBlock Text="{Binding PastRun.AutonomyText}"
                                           Foreground="{Binding PastRun.Autonomy, Converter={x:Static local:Palette.Autonomy}}"
                                           FontSize="11" TextWrapping="Wrap" />
                                <TextBlock Classes="hint" Text="{Binding PastRun.WorkerText}" FontSize="11" />
                                <TextBlock Classes="hint" Text="{Binding PastRun.StagingText}" FontSize="11" />
                            </StackPanel>

                            <!-- What is left of a line written on 2026-09-05, when this panel could
                                 only show. Two days later Retry and Run again were added to the
                                 header above it and nobody re-read this: it went on saying "nothing
                                 here re-runs it" directly under two buttons that do. A caption that
                                 contradicts a button is worse than no caption - it tells the person
                                 the button must mean something else.

                                 "Read-only" went with it. It described the PANEL, and had come to
                                 read as a claim about the RUN - which, on a run whose own settings
                                 say changes were applied directly, was the opposite of true. That
                                 the panel shows rather than edits is said by the panel; the log's
                                 scope is the part that still needed saying. -->
                            <TextBlock Classes="hint" TextWrapping="Wrap"
                                       Text="This run has finished. The log tab only holds the current session." />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

            </DockPanel>

                <!-- Fixed-height current action panel, below the central run views. -->
                <Border Grid.Row="1" Grid.Column="0"
                        Background="{DynamicResource Brand.Bg}"
                        BorderBrush="{DynamicResource Brand.Line}" BorderThickness="0,1,0,0"
                        Padding="16,12,10,12">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <TextBlock Classes="panelHeader" Text="Current action" Margin="0" />
                        <ScrollViewer Grid.Row="1"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <SelectableTextBlock Text="{Binding CurrentAction}" TextWrapping="Wrap"
                                                 FontSize="12"
                                                 Foreground="{DynamicResource Brand.TextBody}" />
                        </ScrollViewer>
                    </Grid>
                </Border>

            </Grid>

        </DockPanel>
        </Grid>
    </Grid>
</Window>
