<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Enactive.App.Ui.ViewModels"
        xmlns:local="using:Enactive.App.Ui"
        x:Class="Enactive.App.Ui.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Enactive"
        Width="1080" Height="720">

    <DockPanel LastChildFill="True">

        <!-- ── Command bar ──────────────────────────────────────────────────── -->
        <StackPanel DockPanel.Dock="Top" Margin="12,12,12,6" Spacing="6">

            <StackPanel Orientation="Horizontal" Spacing="6">
                <ItemsControl ItemsSource="{Binding Verbs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:VerbChipViewModel">
                            <Button Content="{Binding Verb}" Command="{Binding Command}"
                                    FontSize="11" Padding="8,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Ctrl+K to focus · Enter to run · Ctrl+Enter = newline"
                           Classes="hint" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>

            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Spacing="6" VerticalAlignment="Center">
                    <Button Content="Run" Width="72" Command="{Binding RunCommand}" />
                    <Button Content="Stop" Width="72" Command="{Binding StopCommand}" />
                </StackPanel>
                <TextBox x:Name="InputBox"
                         Text="{Binding InputText}"
                         IsEnabled="{Binding IsIdle}"
                         Watermark="What do you want to accomplish?"
                         AcceptsReturn="True" MinHeight="56" TextWrapping="Wrap" />
            </DockPanel>
        </StackPanel>

        <Grid ColumnDefinitions="240,*,320">

            <!-- ── Left: workspace, autonomy, tools ─────────────────────────── -->
            <ScrollViewer Grid.Column="0">
                <StackPanel Margin="12,6,6,12" Spacing="8">
                    <TextBlock Classes="panelHeader" Text="WORKSPACE" />
                    <TextBox Text="{Binding WorkspacePath}" IsEnabled="{Binding IsIdle}"
                             Watermark="Workspace folder" TextWrapping="Wrap" />
                    <TextBlock Classes="hint" Text="{Binding ModelLabel}" />

                    <TextBlock Classes="panelHeader" Text="RECENT" />
                    <ListBox MaxHeight="150"
                             ItemsSource="{Binding RecentWorkspaces}"
                             SelectedItem="{Binding SelectedRecent}" />

                    <TextBlock Classes="panelHeader" Text="AUTONOMY" />
                    <TextBlock Text="{Binding AutonomyLabel}" Foreground="{Binding AutonomyBrush}" FontSize="12" />
                    <Slider Minimum="0" Maximum="3" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding AutonomyLevel, Mode=TwoWay}" IsEnabled="{Binding IsIdle}" />
                    <CheckBox Content="Stage changes (review before apply)"
                              IsChecked="{Binding StageChanges}" IsEnabled="{Binding IsIdle}" />
                    <CheckBox Content="Run in background (Inbox)" IsChecked="{Binding RunInBackground}" />

                    <Border Height="8" />
                    <TextBlock Classes="hint" Text="Role" />
                    <ComboBox ItemsSource="{Binding WorkerRoles}" SelectedIndex="{Binding SelectedWorkerIndex, Mode=TwoWay}" />

                    <Border Height="6" />
                    <Button Content="Timeline" HorizontalAlignment="Stretch" Command="{Binding TimelineCommand}" />
                    <Button Content="Log" HorizontalAlignment="Stretch" Command="{Binding LogCommand}" />
                    <Button Content="Env" HorizontalAlignment="Stretch" Command="{Binding EnvironmentCommand}" />
                    <Button Content="{Binding InboxLabel}" HorizontalAlignment="Stretch" Command="{Binding InboxCommand}" />
                    <Button Content="Settings" HorizontalAlignment="Stretch" Command="{Binding SettingsCommand}" />

                    <Border Height="10" />
                    <TextBlock Classes="hint" Text="Environment" />
                    <TextBlock Classes="hint" Text="{Binding EnvironmentSummary}" />
                </StackPanel>
            </ScrollViewer>

            <!-- ── Centre: the plan-step feed ───────────────────────────────── -->
            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Steps}" Margin="6,6,6,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StepCardViewModel">
                            <local:StepCardView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ── Right: AI status, decision, artifacts ────────────────────── -->
            <DockPanel Grid.Column="2" Margin="6,6,12,12">
                <StackPanel DockPanel.Dock="Top" Spacing="4">
                    <TextBlock Classes="panelHeader" Text="AI STATUS" />
                    <TextBlock Text="{Binding StatusPhase}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Classes="hint" Text="{Binding StatusProgress}" FontSize="12" />
                    <TextBlock Classes="hint" Text="{Binding StatusElapsed}" FontSize="12" />

                    <Border Background="{Binding AgentBrush}" IsVisible="{Binding IsAgentVisible}"
                            CornerRadius="10" Padding="10,2" HorizontalAlignment="Left" Margin="0,4,0,0">
                        <TextBlock Text="{Binding AgentBadge}" FontSize="11"
                                   Foreground="{DynamicResource Brand.Text}" />
                    </Border>

                    <TextBlock Classes="hint" Text="Current action" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding CurrentAction}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource Brand.TextBody}" />

                    <!-- A decision card means the run is BLOCKED waiting on the user - caution, not
                         action - so it is amber, not ember. Ember belongs to the Allow button. -->
                    <Border IsVisible="{Binding IsDecisionVisible}"
                            Background="{DynamicResource Brand.DecisionFill}"
                            BorderBrush="{DynamicResource Brand.DecisionBorder}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12" Margin="0,8,0,8">
                        <StackPanel>
                            <TextBlock Text="USER DECISION REQUIRED" FontWeight="Bold" />
                            <TextBlock Text="{Binding DecisionText}" TextWrapping="Wrap"
                                       Margin="0,4,0,0" FontSize="12" />
                            <ItemsControl ItemsSource="{Binding DecisionOptions}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DecisionOptionViewModel">
                                        <Button Content="{Binding Label}" Command="{Binding Command}"
                                                Margin="0,0,8,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="panelHeader" Text="ARTIFACTS" />
                </StackPanel>

                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Artifacts}">
                        <ItemsControl.DataTemplates>

                            <!-- A file written straight to disk. -->
                            <DataTemplate DataType="vm:ArtifactItemViewModel">
                                <Border Background="{DynamicResource Brand.CardFill}" CornerRadius="4"
                                        Padding="8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding RelativePath}" TextWrapping="Wrap"
                                                   FontFamily="Consolas, Menlo, monospace" FontSize="12" />
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                            <Button Content="Review" Command="{Binding ReviewCommand}"
                                                    FontSize="11" Padding="8,2" />
                                            <Button Content="Undo" Command="{Binding UndoCommand}"
                                                    FontSize="11" Padding="8,2" />
                                            <TextBlock Classes="hint" Text="{Binding Status}"
                                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>

                            <!-- A change waiting for apply or reject, with its diff. -->
                            <DataTemplate DataType="vm:StagedChangeViewModel">
                                <Border Background="{DynamicResource Brand.CardFill}"
                                        BorderBrush="{DynamicResource Brand.Amber}"
                                        BorderThickness="2,0,0,0" CornerRadius="4"
                                        Padding="8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding RelativePath}" TextWrapping="Wrap"
                                                   FontFamily="Consolas, Menlo, monospace" FontSize="12" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Classes="hint" Text="{Binding Tag}" />
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}"
                                                       FontSize="11" Margin="6,0,0,0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                            <Button Content="Diff" Command="{Binding DiffCommand}"
                                                    FontSize="11" Padding="8,2" />
                                            <Button Content="Apply" Command="{Binding ApplyCommand}"
                                                    FontSize="11" Padding="8,2" />
                                            <Button Content="Reject" Command="{Binding RejectCommand}"
                                                    FontSize="11" Padding="8,2" />
                                        </StackPanel>
                                        <Border IsVisible="{Binding IsDiffVisible}"
                                                Background="{DynamicResource Brand.Scrim}"
                                                CornerRadius="3" Padding="6" Margin="0,6,0,0"
                                                MaxHeight="220">
                                            <ScrollViewer>
                                                <ItemsControl ItemsSource="{Binding Diff}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:DiffLineViewModel">
                                                            <TextBlock Text="{Binding Text}"
                                                                       Foreground="{Binding Brush}"
                                                                       FontFamily="Consolas, Menlo, monospace"
                                                                       FontSize="11" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>

                        </ItemsControl.DataTemplates>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
