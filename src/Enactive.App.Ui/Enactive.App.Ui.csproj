<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Enactive.App.Ui</RootNamespace>
    <AssemblyName>enactive-ui</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Views are .axaml; Avalonia's build tasks pick up **\*.axaml on their own, so there is no
         item group for them. Bindings are compiled with the XAML, which turns a typo in a binding
         path into a build error instead of a silently empty control - the reason x:DataType is
         mandatory on every view that binds. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The name generator otherwise emits this.AttachDevTools() into the generated
         InitializeComponent, which needs the Avalonia.Diagnostics package. We do not ship it. -->
    <AvaloniaNameGeneratorAttachDevTools>false</AvaloniaNameGeneratorAttachDevTools>
    <!-- AVLN3001 warns that a view without a public parameterless constructor cannot be built by
         the RUNTIME XAML loader. That loader is used exactly once here - App.axaml.cs calls
         AvaloniaXamlLoader.Load(this) for the Application itself. Every window is constructed in
         C# with the collaborators it needs (LogWindow takes the LogHub whose entries it shows,
         SettingsWindow the settings it edits, and so on), and the compiled InitializeComponent is
         what builds their trees. Satisfying the warning would mean adding a parameterless
         constructor that fabricates those collaborators - a log window wired to an empty LogHub
         that stays blank forever - which is a worse failure than the warning it silences. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Brand assets: the app icon is loaded at runtime via avares://enactive-ui/Assets/icon.png -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- All three MUST be the same version, or you get a TypeLoadException at startup.
         Pinned to match the Avalonia.Base that resolved on this machine. -->
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Enactive.Core\Enactive.Core.csproj" />
    <ProjectReference Include="..\Enactive.Providers\Enactive.Providers.csproj" />
    <ProjectReference Include="..\Enactive.Tools\Enactive.Tools.csproj" />
    <ProjectReference Include="..\Enactive.Workspace\Enactive.Workspace.csproj" />
    <ProjectReference Include="..\Enactive.Agents\Enactive.Agents.csproj" />
  </ItemGroup>
</Project>
