<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Enactive.App.Ui"
        x:Class="Enactive.App.Ui.ChecksWindow"
        Title="Checks"
        Width="760" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brand.Bg}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True">

    <!-- A workspace's checks, from its card (Plan Phase 3.5): the same list Settings shows for the global ones. -->
    <Grid RowDefinitions="Auto,*" Margin="{Binding $parent[Window].OffScreenMargin}">
        <local:TitleBarView Grid.Row="0" />
        <local:ChecksView Grid.Row="1" x:Name="List" Margin="12,10,12,12" />
    </Grid>
</Window>
