<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Enactive.App.Ui.ViewModels"
        xmlns:local="using:Enactive.App.Ui"
        xmlns:core="using:Enactive.Core.Guidance"
        x:Class="Enactive.App.Ui.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="900" Height="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brand.Bg}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True">

    <!-- OffScreenMargin keeps a MAXIMISED window inside the screen: with the client
         area extended over the decorations, the platform would otherwise push the edges
         a few pixels past the work area. -->
    <Grid RowDefinitions="Auto,*" Margin="{Binding $parent[Window].OffScreenMargin}">

        <local:TitleBarView Grid.Row="0" />

        <Panel Grid.Row="1">

        <DockPanel LastChildFill="True">

            <StackPanel DockPanel.Dock="Bottom" Classes="actions" HorizontalAlignment="Right"
                        Margin="12">
                <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom" Classes="hint" Margin="12,0,12,8"
                       Text="{Binding StartupNote}" IsVisible="{Binding HasStartupNote}" />

            <Grid ColumnDefinitions="188,*">

                <!-- The sections. Placeholders are listed rather than hidden: the shape of the
                     window should say where the rest is going. -->
                <Border Grid.Column="0" Classes="context" Padding="8,12,8,12">
                    <StackPanel Spacing="0">
                        <Button Classes="nav" Classes.on="{Binding IsGeneral}"
                                Content="General" Command="{Binding ShowGeneralCommand}" />
                        <Button Classes="nav" Classes.on="{Binding IsAccount}"
                                Content="Account" Command="{Binding ShowAccountCommand}" />
                        <Button Classes="nav" Classes.on="{Binding IsRemote}"
                                Content="Remote access" Command="{Binding ShowRemoteCommand}" />
                        <Button Classes="nav" Classes.on="{Binding IsWritableRoots}"
                                Content="Writable folders" Command="{Binding ShowWritableRootsCommand}" />
                        <Button Classes="nav" Classes.on="{Binding IsSmtp}"
                                Content="SMTP" Command="{Binding ShowSmtpCommand}" />
                        <Button Classes="nav" Classes.on="{Binding IsAbout}"
                                Content="About" Command="{Binding ShowAboutCommand}" />

                        <Border Height="1" Margin="10,10,0,8"
                                Background="{DynamicResource Brand.Line}" />
                        <TextBlock Classes="panelHeader" Text="AI" Margin="10,0,0,4" />

                        <Button Classes="nav" Classes.on="{Binding IsAiGeneral}"
                                Content="General" Command="{Binding ShowAiGeneralCommand}" />
                        <Button Classes="nav" Classes.on="{Binding IsAiProviders}"
                                Content="Providers" Command="{Binding ShowAiProvidersCommand}" />
                        <Button Classes="nav" Classes.on="{Binding IsAiTeam}"
                                Content="Team" Command="{Binding ShowAiTeamCommand}" />
                        <Button Classes="nav" Classes.on="{Binding IsAiPhases}"
                                Content="Phases" Command="{Binding ShowAiPhasesCommand}" />
                        <Button Classes="nav" Classes.on="{Binding IsMcp}"
                                Content="MCP" Command="{Binding ShowMcpCommand}" />
                        <Button Classes="nav" Classes.on="{Binding IsTemplates}"
                                Content="Templates" Command="{Binding ShowTemplatesCommand}" />
                    </StackPanel>
                </Border>

                <Panel Grid.Column="1" Margin="4,0,0,0">

                <DockPanel IsVisible="{Binding IsMcp}" Margin="12">
                    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
                        <TextBlock Classes="label" Text="MCP servers" />
                        <TextBlock Classes="hint" Text="Connect local programs through stdio or remote servers through HTTP. Enabled servers connect for each new run; running tasks keep their current settings." />
                        <TextBlock Classes="hint" Text="Allow mcp__* under AI · Team to let a worker use these tools. Calls ask for approval by default. External changes are not staged or undone by Enactive." />
                        <TextBlock Classes="hint" TextWrapping="Wrap" Foreground="{DynamicResource Brand.Danger}"
                                   IsVisible="{Binding HasMcpReachNote}" Text="{Binding McpReachNote}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Classes="actions">
                        <Button Content="Add" Command="{Binding AddMcpCommand}" />

                    </StackPanel>
                    <ListBox x:Name="McpList" Classes="cards" ItemsSource="{Binding McpServers}" SelectedItem="{Binding SelectedMcp}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:McpServerRow">
                                <Border Classes="card" BorderBrush="{Binding EdgeBrush}">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Classes="cardTitle" Text="{Binding Name}" />
                                            <TextBlock Classes="cardMeta" Text="{Binding Meta}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Reach}" Classes="cardMeta" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                                            <Button Classes="rowIcon" Command="{Binding EditCommand}" ToolTip.Tip="Edit">
                                                <Viewbox Width="16" Height="16">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M 4,20 L 4,16 L 15.5,4.5 L 19.5,8.5 L 8,20 Z" />
                                                        <Path Data="M 13.5,6.5 L 17.5,10.5" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                            <Button Classes="rowIcon destructive" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove">
                                                <Viewbox Width="15" Height="15">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M 6,6 L 18,18 M 18,6 L 6,18" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <DockPanel IsVisible="{Binding IsTemplates}" Margin="12">
                    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
                        <TextBlock Classes="label" Text="Task templates" />
                        <TextBlock Classes="hint" Text="A saved task: what to ask for, the bounds it runs under, and the checks that decide whether it finished. Pick one from Templates on the main window to run it." />
                        <TextBlock Classes="hint" Text="Templates are FILES, and the editor writes them as soon as you press Save there. Cancel on this window does not undo them, unlike everything else here." />
                        <TextBlock Classes="hint" Text="A file saved under a built-in's id replaces that built-in; delete the file and the original comes back. A workspace template replaces a global one of the same id, which is how a project keeps its own version next to its code." />
                        <TextBlock Classes="hint" Text="{Binding TemplateFolders}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Classes="actions">
                        <Button Content="New template" Command="{Binding AddTemplateCommand}" />
                    </StackPanel>
                    <ListBox x:Name="TemplateList" Classes="cards" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TemplateRow">
                                <Border Classes="card" BorderBrush="{Binding EdgeBrush}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Classes="cardTitle" Text="{Binding Name}" />
                                            <TextBlock Classes="cardMeta" Text="{Binding Meta}" />
                                            <TextBlock Classes="cardMeta" Text="{Binding Description}" IsVisible="{Binding HasDescription}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                                            <Button Classes="rowIcon" Command="{Binding EditCommand}" ToolTip.Tip="Edit">
                                                <Viewbox Width="16" Height="16">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M 4,20 L 4,16 L 15.5,4.5 L 19.5,8.5 L 8,20 Z" />
                                                        <Path Data="M 13.5,6.5 L 17.5,10.5" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                            <Button Classes="rowIcon" Command="{Binding DuplicateCommand}" ToolTip.Tip="Duplicate">
                                                <Viewbox Width="16" Height="16">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M 8,3 L 20,3 L 20,15 M 4,7 L 16,7 L 16,21 L 4,21 Z" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                            <Button Classes="rowIcon destructive" Command="{Binding RemoveCommand}"
                                                    IsVisible="{Binding IsEditable}" ToolTip.Tip="{Binding RemoveTip}">
                                                <Viewbox Width="15" Height="15">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M 6,6 L 18,18 M 18,6 L 6,18" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <StackPanel IsVisible="{Binding IsGeneral}" Margin="12" Spacing="6">

                    <TextBlock Classes="label" Text="Start-up" />
                    <CheckBox Content="Run with computer startup"
                              IsChecked="{Binding RunAtStartup}"
                              IsEnabled="{Binding StartupSupported}" />
                    <TextBlock Classes="hint" IsVisible="{Binding HasStartupNote}"
                               Text="{Binding StartupNote}" />
                    <TextBlock Classes="hint"
                               Text="Adds Enactive to your own login, under HKCU — no administrator rights, and nothing changed for other users of this computer. Applied when you press Save." />

                    <TextBlock Classes="label" Text="Close Main Panel Action" Margin="0,10,0,0" />
                    <TextBlock Classes="hint"
                               Text="What the main window's close button does. Hiding it keeps a run going - including anything started in the background, which lives in this process and dies with it." />
                    <RadioButton GroupName="CloseAction" IsChecked="{Binding CloseToTray}"
                                 Content="Minimize to system tray without exiting" />
                    <RadioButton GroupName="CloseAction" IsChecked="{Binding ExitOnClose}"
                                 Content="Exit program" />
                    <TextBlock Classes="hint"
                               Text="Either way, quitting asks first when a run is still going. With no system tray on this desktop the window has nowhere to hide, and closing it exits whatever is chosen here." />

                </StackPanel>

                <StackPanel IsVisible="{Binding IsAccount}" Margin="12" Spacing="6">
                    <TextBlock Classes="label" Text="Account" />
                    <TextBlock Classes="hint"
                               Text="Nothing here yet. Enactive has no account of its own; provider credentials live under AI · Providers." />
                </StackPanel>

                <StackPanel IsVisible="{Binding IsSmtp}" Margin="12" Spacing="6">
                    <TextBlock Classes="label" Text="SMTP" />
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="The account the send_email tool sends from. Until a host and at least one recipient are set, the tool tells the agent it is unavailable rather than failing halfway through a task." />

                    <TextBlock Classes="label" Text="Server" Margin="0,8,0,0" />
                    <Grid ColumnDefinitions="*,90" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Text="{Binding SmtpHost}" PlaceholderText="smtp.example.com" />
                        <TextBox Grid.Column="1" Text="{Binding SmtpPort}" PlaceholderText="587" />
                    </Grid>
                    <CheckBox Content="Upgrade the connection with STARTTLS" IsChecked="{Binding SmtpStartTls}" />
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="587 with STARTTLS is what most providers want. For implicit TLS on 465, set the port and clear the box." />

                    <TextBlock Classes="label" Text="User" Margin="0,8,0,0" />
                    <TextBox Text="{Binding SmtpUser}" PlaceholderText="you@example.com" />
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="Leave empty for a relay that wants no credentials — a submission agent on your own network. Nothing is sent to the server then." />

                    <TextBlock Classes="label" Text="Password" Margin="0,8,0,0" />
                    <TextBox Text="{Binding SmtpPassword}" PasswordChar="&#8226;" />
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="Stored encrypted with your Windows account, the same as an API key. Leave the box as it is to keep the stored password; empty it to remove it." />

                    <TextBlock Classes="label" Text="From" Margin="0,8,0,0" />
                    <TextBox Text="{Binding SmtpFrom}" PlaceholderText="(the user above)" />

                    <TextBlock Classes="label" Text="May send to" Margin="0,12,0,0" />
                    <TextBox Text="{Binding SmtpRecipients}" AcceptsReturn="True" Height="70"
                             TextWrapping="NoWrap" PlaceholderText="you@example.com" />
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="One address per line, and this list is the whole of what send_email may do. An address that is not on this list is refused, and no task can add one." />

                    <TextBlock Classes="hint" TextWrapping="Wrap" Foreground="{DynamicResource Brand.Danger}"
                               IsVisible="{Binding HasSmtpProblem}" Text="{Binding SmtpProblem}" />

                    <CheckBox Content="Send without asking each time" Margin="0,12,0,0"
                              IsChecked="{Binding SmtpSendWithoutAsking}" />
                    <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding SmtpAsking}" />

                    <TextBlock Classes="hint" TextWrapping="Wrap" Margin="0,10,0,0" Text="{Binding SmtpState}" />
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="" />
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="" />
                </StackPanel>

                <StackPanel IsVisible="{Binding IsRemote}" Margin="12" Spacing="6">
                    <TextBlock Classes="label" Text="Remote access" />
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="Lets you start tasks on this computer from a phone. This computer connects out to the gateway and holds the connection open; nothing listens for incoming connections here, and no port needs opening." />

                    <CheckBox Content="Answer this computer's remote gateway"
                              IsChecked="{Binding RemoteEnabled}" Margin="0,6,0,0" />

                    <TextBlock Classes="label" Text="Gateway address" Margin="0,8,0,0" />
                    <TextBox Text="{Binding RemoteGatewayUrl}" PlaceholderText="https://remote.enactive.dev" />

                    <TextBlock Classes="label" Text="Device token" Margin="0,8,0,0" />
                    <TextBox Text="{Binding RemoteToken}" PasswordChar="•" />
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="Register this computer on the gateway's Computers page; it shows a token once. The token alone says which computer this is, so there is nothing else to copy across. Stored encrypted with your Windows account, the same as an API key. Leave the box as it is to keep the stored token; empty it to remove it." />

                    <TextBlock Classes="hint" TextWrapping="Wrap" Foreground="{DynamicResource Brand.Danger}"
                               IsVisible="{Binding HasRemoteProblem}" Text="{Binding RemoteProblem}" />

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <Button Content="Test connection" Command="{Binding TestRemoteCommand}"
                                IsEnabled="{Binding CanTestRemote}" />
                    </StackPanel>
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               IsVisible="{Binding HasRemoteResult}" Text="{Binding RemoteResult}" />
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="Tries the settings as typed, without saving them. A successful check also makes this computer show as online on the phone." />

                    <TextBlock Classes="hint" TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="A task started from the phone runs at the autonomy level set on the main window and never runs shell commands, whatever that level says. Permission questions it does raise can be answered from either the phone or here - whichever answers first decides." />
                </StackPanel>

                <DockPanel IsVisible="{Binding IsAbout}" Margin="12" LastChildFill="True">

                    <StackPanel DockPanel.Dock="Top" Spacing="6">
                        <TextBlock Text="Enactive" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Classes="hint" Text="An AI workspace." />

                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" Margin="0,10,0,0">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="hint" Text="Version" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppVersion}"
                                       FontFamily="Consolas, Menlo, monospace" FontSize="12"
                                       TextWrapping="Wrap" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="hint" Text="Built" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BuiltAt}"
                                       FontFamily="Consolas, Menlo, monospace" FontSize="12" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="hint" Text="Runtime" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RuntimeInfo}"
                                       FontSize="12" TextWrapping="Wrap" />
                        </Grid>

                        <TextBlock Classes="panelHeader" Text="COMPONENTS" Margin="0,14,0,0" />
                        <TextBlock Classes="hint"
                                   Text="All of these ship from one build, so they carry the same version. Two different numbers below mean a stale file is sitting in the program folder." />
                    </StackPanel>

                    <ScrollViewer Margin="0,6,0,0">
                        <ItemsControl ItemsSource="{Binding Components}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:BuildComponent">
                                    <Grid ColumnDefinitions="*,140,120" Margin="0,0,0,3">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Version}" FontSize="12"
                                                   FontFamily="Consolas, Menlo, monospace"
                                                   Foreground="{DynamicResource Brand.TextBody}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11"
                                                   Foreground="{DynamicResource Brand.TextFaint}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                </DockPanel>

                <!-- Writable folders: what has been granted, and the only place it can be taken
                     back. Revoking is immediate and does not wait for Save - see the pane's own
                     sentence, and RevokeWritableRoot for why. -->
                <Panel IsVisible="{Binding IsWritableRoots}">
                    <DockPanel LastChildFill="True" Margin="12">
                        <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,8"
                                   Text="A run may only write inside its workspace. When a command tries to write somewhere else you are asked, and one of the answers is &quot;keep for this workspace&quot; — those are listed here. Revoking takes effect at once and is not undone by Cancel: taking a permission away is not a setting." />

                        <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,8"
                                   IsVisible="{Binding !WritableRootRows.Count}"
                                   Text="{Binding WritableRootsEmpty}" />

                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding WritableRootRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WritableRootRow">
                                        <Border Classes="card" Margin="0,0,0,6" Padding="10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{Binding Folder}" FontWeight="SemiBold" />
                                                    <TextBlock Classes="hint" Text="{Binding Workspace}" />
                                                    <TextBlock Classes="hint"
                                                               IsVisible="{Binding IsOrphan}"
                                                               Foreground="{DynamicResource Brand.Warning}"
                                                               Text="Still in force. Revoking removes every folder kept for that workspace, because there is no path left to name one by." />
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="danger"
                                                        VerticalAlignment="Center"
                                                        Content="Revoke" Command="{Binding RevokeCommand}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Panel>

                <Panel IsVisible="{Binding IsAiGeneral}">
                    <ScrollViewer>
                        <StackPanel Margin="12" Spacing="6">

                            <!-- Every explanation on this page is behind its own "?" — the text is
                                 in Core (SettingsAdvice), unchanged, and the page is now the
                                 controls themselves. Stacked, the same paragraphs put the switch
                                 somebody came for four scrolls down, behind reasoning about
                                 switches they were not changing. -->

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="label" Text="Context length (num_ctx)" />
                                <local:HintView Text="{x:Static core:SettingsAdvice.NumCtx}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBox Text="{Binding NumCtxText}"
                                     PlaceholderText="e.g. 8192 — blank uses whatever the model already has loaded" />

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="label" Text="Global instructions" />
                                <local:HintView Text="{x:Static core:SettingsAdvice.GlobalInstructions}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBox Classes="multiline" MinHeight="220" Text="{Binding GlobalInstructions}"
                                     PlaceholderText="Global instructions — applied to every run" />

                            <!-- A section heading and nothing else now: what used to sit under it
                                 explained the FIRST checkbox, so it went there. -->
                            <TextBlock Classes="label" Text="Local model behaviour" />

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <CheckBox IsChecked="{Binding DisableThinking}"
                                          Content="Disable local model reasoning (&lt;think&gt;) — recommended for qwen3" />
                                <local:HintView Text="{x:Static core:SettingsAdvice.DisableThinking}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <CheckBox IsChecked="{Binding VerifyWrites}"
                                          Content="Verify writes by reading files back — helps weak local models, adds a round-trip" />
                                <local:HintView Text="{x:Static core:SettingsAdvice.VerifyWrites}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <CheckBox IsChecked="{Binding ReviewContent}"
                                          Content="Review what a step WROTE when it ran no commands" />
                                <local:HintView Text="{x:Static core:SettingsAdvice.ReviewContent}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <CheckBox IsChecked="{Binding CheckSoundness}"
                                          Content="Ask a passed step what actually proved it" />
                                <local:HintView Text="{x:Static core:SettingsAdvice.CheckSoundness}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <CheckBox IsChecked="{Binding RevertRejectedSteps}"
                                          Content="Put a rejected step's files back to how they were" />
                                <local:HintView Text="{x:Static core:SettingsAdvice.RevertRejectedSteps}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="label" Text="Review retries" />
                                <local:HintView Text="{x:Static core:SettingsAdvice.ReviewRetries}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBox Text="{Binding ReviewRetriesText}" PlaceholderText="1 = two tries in total" />

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <CheckBox IsChecked="{Binding AllowImplicitToolCalls}"
                                          Content="Run tool calls the model only described in text — unsafe, off by default" />
                                <local:HintView Text="{x:Static core:SettingsAdvice.AllowImplicitToolCalls}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="label" Text="Parallel steps" />
                                <local:HintView Text="{x:Static core:SettingsAdvice.MaxParallelSteps}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBox Text="{Binding MaxParallelStepsText}" PlaceholderText="1 = one step at a time" />

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="label" Text="Evidence shown to the reviewer" />
                                <local:HintView Text="{x:Static core:SettingsAdvice.EvidenceBudget}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBox Text="{Binding EvidenceBudgetText}" PlaceholderText="6000 = the default" />

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="label" Text="Shell commands" />
                                <local:HintView Text="{x:Static core:SettingsAdvice.ShellCommands}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                            <ComboBox SelectedIndex="{Binding ShellCommandsIndex}" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Follow the autonomy level (default)" />
                                <ComboBoxItem Content="Always ask, even when autonomous" />
                                <ComboBoxItem Content="Off — refuse shell commands" />
                            </ComboBox>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="label" Text="Keep logs for (days)" />
                                <local:HintView Text="{x:Static core:SettingsAdvice.LogRetentionDays}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBox Text="{Binding LogRetentionDaysText}" PlaceholderText="14 = the default, 0 = keep everything" />

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <CheckBox IsChecked="{Binding LogPromptBodies}"
                                          Content="Write the full text of every prompt to the log" />
                                <local:HintView Text="{x:Static core:SettingsAdvice.LogPromptBodies}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Panel>

                <Panel IsVisible="{Binding IsAiProviders}">
                    <DockPanel LastChildFill="True" Margin="12">
                        <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,6"
                                   Text="Green runs on this machine; blue is reached over the network — the one thing about a provider worth seeing without reading it." />
                        <StackPanel DockPanel.Dock="Bottom" Classes="actions">
                            <Button Content="Add" Command="{Binding AddProviderCommand}" />
                        </StackPanel>
                        <ListBox x:Name="ProviderList" Classes="cards" ItemsSource="{Binding Providers}"
                                 SelectedItem="{Binding SelectedProvider}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProviderRow">
                                    <Border Classes="card" BorderBrush="{Binding EdgeBrush}">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                        Margin="0,0,10,0" Spacing="9">
                                                <!-- What the last check learned, and grey until one
                                                     was made. The tooltip carries the sentence and
                                                     the TIME: a dot on its own says how things were
                                                     at a moment it does not name. -->
                                                <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                         Fill="{Binding HealthBrush}"
                                                         ToolTip.Tip="{Binding HealthTip}" />
                                                <StackPanel>
                                                    <TextBlock Classes="cardTitle" Text="{Binding Name}" />
                                                    <TextBlock Classes="cardMeta" Text="{Binding Meta}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Reach}"
                                                       Classes="cardMeta" VerticalAlignment="Center"
                                                       Margin="0,0,10,0" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        VerticalAlignment="Center" Spacing="2">
                                                <Button Classes="rowIcon" Command="{Binding EditCommand}"
                                                        ToolTip.Tip="Edit">
                                                    <Viewbox Width="16" Height="16">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M 4,20 L 4,16 L 15.5,4.5 L 19.5,8.5 L 8,20 Z" />
                                                            <Path Data="M 13.5,6.5 L 17.5,10.5" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                                <Button Classes="rowIcon destructive" Command="{Binding RemoveCommand}"
                                                        ToolTip.Tip="Remove">
                                                    <Viewbox Width="15" Height="15">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M 6,6 L 18,18 M 18,6 L 6,18" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Panel>

                <Panel IsVisible="{Binding IsAiTeam}">
                    <DockPanel LastChildFill="True" Margin="12">
                        <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,6"
                                   Text="The main window's role picker chooses which worker handles a run. Honesty rules and global instructions are added to every worker automatically. The edge is the worker's permission level, on the same green-to-red scale as the autonomy slider." />
                        <StackPanel DockPanel.Dock="Bottom" Classes="actions">
                            <Button Content="Add" Command="{Binding AddWorkerCommand}" />
                        </StackPanel>
                        <ListBox x:Name="WorkerList" Classes="cards" ItemsSource="{Binding Workers}"
                                 SelectedItem="{Binding SelectedWorker}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:WorkerRow">
                                    <Border Classes="card" BorderBrush="{Binding EdgeBrush}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Classes="cardTitle" Text="{Binding Name}" />
                                                <TextBlock Classes="cardMeta" Text="{Binding Meta}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center" Spacing="2">
                                                <Button Classes="rowIcon" Command="{Binding EditCommand}"
                                                        ToolTip.Tip="Edit">
                                                    <Viewbox Width="16" Height="16">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M 4,20 L 4,16 L 15.5,4.5 L 19.5,8.5 L 8,20 Z" />
                                                            <Path Data="M 13.5,6.5 L 17.5,10.5" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                                <Button Classes="rowIcon destructive" Command="{Binding RemoveCommand}"
                                                        ToolTip.Tip="Remove">
                                                    <Viewbox Width="15" Height="15">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M 6,6 L 18,18 M 18,6 L 6,18" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Panel>

                <Panel IsVisible="{Binding IsAiPhases}">
                    <ScrollViewer>
                        <StackPanel Margin="12" Spacing="6">

                            <TextBlock Classes="hint"
                                       Text="Execute always runs on the selected worker's own model. Plan and Review use the models bound here. Choose (none) for Plan to plan on the executing model, or for Review to skip review entirely (single-agent)." />

                            <!-- Label and its "?" on one row. The advice behind each is in
                                 Core (PhaseAdvice), not here: four identical drop-downs over the
                                 same model list gave a person no reason to put one model in one
                                 and a different one in another, and the paragraph above answers
                                 how the phases WORK rather than which of your models goes where. -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="label" Text="Plan model" />
                                <local:HintView Text="{x:Static core:PhaseAdvice.Plan}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding ModelCatalog}" SelectedItem="{Binding Plan}" />

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="label" Text="Review model" />
                                <local:HintView Text="{x:Static core:PhaseAdvice.Review}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding ModelCatalog}" SelectedItem="{Binding Review}" />

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="label" Text="Execute · light (trivial steps)" />
                                <local:HintView Text="{x:Static core:PhaseAdvice.Light}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding ModelCatalog}" SelectedItem="{Binding ExecuteLight}" />

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="label" Text="Execute · heavy (complex steps)" />
                                <local:HintView Text="{x:Static core:PhaseAdvice.Heavy}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding ModelCatalog}" SelectedItem="{Binding ExecuteHeavy}" />

                        </StackPanel>
                    </ScrollViewer>
                </Panel>

                </Panel>
            </Grid>
        </DockPanel>
        </Panel>
    </Grid>

</Window>
