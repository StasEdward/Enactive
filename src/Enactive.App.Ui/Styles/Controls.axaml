<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      App-wide control styling. Colours come from the brand tokens Brand.PublishTo puts in the
      application's resources, so this file never spells out a hex value; change a colour in
      Brand.cs and every control here follows. DynamicResource, not StaticResource, because the
      tokens are published after this file is loaded.
    -->

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource Brand.Bg}" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brand.Text}" />
    </Style>

    <!-- The label above an input. -->
    <Style Selector="TextBlock.label">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,8,0,2" />
    </Style>

    <!-- Explanatory copy under a control: present, but never competing with the control itself. -->
    <Style Selector="TextBlock.hint">
        <Setter Property="Foreground" Value="{DynamicResource Brand.TextMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Ember means action. The one button that commits a dialog wears it; a destructive button
         never does - that is what Brand.Danger is for. -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource Brand.Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A vertical form: a column of label/input pairs with room to breathe. -->
    <Style Selector="StackPanel.form">
        <Setter Property="Margin" Value="16" />
        <Setter Property="Spacing" Value="6" />
    </Style>

    <!-- The row of buttons that closes a dialog. -->
    <Style Selector="StackPanel.actions">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="8" />
        <Setter Property="Margin" Value="0,12,0,0" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- A multi-line input (instructions, headers, model lists). -->
    <Style Selector="TextBox.multiline">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</Styles>
