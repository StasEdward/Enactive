<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      App-wide control styling. Colours come from the brand tokens Brand.PublishTo puts in the
      application's resources, so this file never spells out a hex value; change a colour in
      Brand.cs and every control here follows. DynamicResource, not StaticResource, because the
      tokens are published after this file is loaded.
    -->

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource Brand.Bg}" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brand.Text}" />
    </Style>

    <!-- The label above an input. -->
    <Style Selector="TextBlock.label">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,8,0,2" />
    </Style>

    <!-- A small caps-ish section heading in a side panel. -->
    <Style Selector="TextBlock.panelHeader">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Brand.TextMuted}" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <!-- Explanatory copy under a control: present, but never competing with the control itself. -->
    <Style Selector="TextBlock.hint">
        <Setter Property="Foreground" Value="{DynamicResource Brand.TextMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Ember means action. The one button that commits a dialog wears it; a destructive button
         never does - that is what Brand.Danger is for. -->
    <!-- Fluent leaves a button's content aligned to its start, which only shows once a
         button is wider than its label - as every fixed-width button here is. Centre is
         what a button means. Classes that deliberately fill their content edge to edge
         (the workspace card and its rows) set Stretch themselves and win, being more
         specific than this. -->
    <Style Selector="Button">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="StackPanel.form">
        <Setter Property="Margin" Value="16" />
        <Setter Property="Spacing" Value="6" />
    </Style>

    <!-- The row of buttons that closes a dialog. -->
    <Style Selector="StackPanel.actions">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="8" />
        <Setter Property="Margin" Value="0,12,0,0" />
    </Style>

    <!-- ── Inputs ──────────────────────────────────────────────────────────
         Fluent's own fills are a grey that belongs to no palette here, and they
         are where every "this looks like another program" started: a window can
         be laid out perfectly and still read as someone else's if the boxes you
         type into came with the theme. Dressed once, at the control, so every
         window gets it - including the ones nobody has touched.

         PART_BorderElement is the name Fluent gives the box around a TextBox and
         a ComboBox; it is what carries the fill, so it is what has to be told.
    -->
    <Style Selector="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Brand.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brand.Accent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brand.AccentFill}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Brand.Text}" />
        <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Brand.InputFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Brand.InputFillHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.LineStrong}" />
    </Style>
    <!-- Focus is the one place ember belongs on an input: it marks where typing goes. -->
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Brand.InputFillHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Accent}" />
    </Style>
    <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Brand.Scrim}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Line}" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource Brand.Text}" />
        <Setter Property="Padding" Value="8,5" />
    </Style>
    <!-- A ComboBox is coloured in Brand.PublishTo, not here. Its template writes the
         brushes onto its elements as LOCAL values through DynamicResource, and a local
         value outranks every style setter - so the key is the only handle there is. Its
         box is not even called PART_BorderElement; that is the TextBox's. -->

    <!-- ── Buttons ─────────────────────────────────────────────────────────
         The plain button is the one that appears in every window, so it is the
         one that decides whether the app looks like itself.
    -->
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand.CardFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand.CardFillHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.LineStrong}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand.CardFillActive}" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand.Scrim}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Line}" />
    </Style>

    <!-- Declared after the plain button, and in every state, because Fluent repaints a
         button's background on hover and pressed - which would take the ember off the
         one button on the screen that is meant to have it. -->
    <Style Selector="Button.primary">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Accent}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand.AccentHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.AccentHover}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand.AccentPressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.AccentPressed}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- A vertical form: a column of label/input pairs with room to breathe. -->

    <!-- A source filter in the log, and anything else that is on or off. Fluent
         paints a checked toggle in solid accent, which here is solid Ember - the
         same false alarm the status pill had. A tint and an ember edge instead. -->
    <Style Selector="ToggleButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand.CardFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand.CardFillHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.LineStrong}" />
    </Style>
    <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand.AccentFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brand.Text}" />
    </Style>
    <Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand.AccentFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Accent}" />
    </Style>

    <Style Selector="Border.popup">
        <!-- The darkest surface in the app, on purpose: the rows inside are cards made of white at
             10-19%, and over a light panel that is a difference you cannot see. -->
        <Setter Property="Background" Value="{DynamicResource Brand.Bg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.LineStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="BoxShadow" Value="0 10 28 0 #70000000" />
    </Style>

    <Style Selector="ComboBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand.CardFill}" />
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand.AccentFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Accent}" />
    </Style>
    <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand.AccentFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Accent}" />
    </Style>

    <!-- A list sits on whatever it is in, rather than bringing its own grey panel. -->
    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- A disclosure line: clickable text, no button chrome, brightening under the pointer. This is
         what a step card's "Used 3 tools, ran 1 command" toggle is. -->
    <Style Selector="Button.disclosure">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.disclosure /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.disclosure:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.disclosure:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.disclosure TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brand.TextMuted}" />
    </Style>
    <Style Selector="Button.disclosure:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brand.TextBody}" />
    </Style>

    <!-- ── The icon rail ────────────────────────────────────────────────────
         Chrome, not content: it sits on the darkest ink, its icons are quiet
         until you point at them, and only the section you are in takes ember.
    -->
    <Style Selector="Border.rail">
        <Setter Property="Background" Value="{DynamicResource Brand.Rail}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Line}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <Style Selector="Button.rail">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <!-- A 38px button docked in a 52px rail: without this it inherits Stretch, which with an
             explicit Width means left, and every icon sits 7px off centre. -->
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.rail /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.rail:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand.CardFill}" />
    </Style>
    <Style Selector="Button.rail Path">
        <Setter Property="Stroke" Value="{DynamicResource Brand.TextFaint}" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Button.rail:pointerover Path">
        <Setter Property="Stroke" Value="{DynamicResource Brand.Text}" />
    </Style>

    <!-- A selected row is marked, not repainted. Fluent builds selection out of the
         accent, and since the accent is Ember the stock result is a solid ember block -
         which claims to be the action on the screen. A tint and an edge say the same
         thing quietly. -->
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand.AccentFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Accent}" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand.AccentFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Accent}" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brand.Text}" />
    </Style>

    <!-- A filesystem path in a narrow column: trim the FRONT, because the part that
         tells one project from another is at the end. -->
    <Style Selector="TextBlock.path">
        <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextTrimming" Value="PrefixCharacterEllipsis" />
    </Style>

    <!-- ── The window's own title bar ───────────────────────────────────────
         The client area is extended over the system decorations, so this strip
         IS the title bar: it drags the window and carries the caption buttons.
    -->
    <Style Selector="Border.titlebar">
        <Setter Property="Background" Value="{DynamicResource Brand.Rail}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Line}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="Button.caption">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.caption /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand.CardFill}" />
    </Style>
    <Style Selector="Button.caption Path">
        <Setter Property="Stroke" Value="{DynamicResource Brand.TextMuted}" />
        <Setter Property="StrokeThickness" Value="1.2" />
    </Style>
    <Style Selector="Button.caption:pointerover Path">
        <Setter Property="Stroke" Value="{DynamicResource Brand.Text}" />
    </Style>

    <!-- Close is the one destructive control in the chrome, so it takes danger.
         Ember means action and is never spent on destruction. -->
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand.Danger}" />
    </Style>
    <Style Selector="Button.caption.close:pointerover Path">
        <Setter Property="Stroke" Value="{DynamicResource Brand.Bg}" />
    </Style>

    <!-- ── The context column ──────────────────────────────────────────────── -->
    <Style Selector="Border.context">
        <Setter Property="Background" Value="{DynamicResource Brand.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Line}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <!-- A multi-line input (instructions, headers, model lists). -->
    <Style Selector="TextBox.multiline">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- ── The task header ─────────────────────────────────────────────────
         What the run is called, what was actually asked for, and the phase.
    -->
    <Style Selector="Border.taskHeader">
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Line}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="16,10,16,12" />
    </Style>

    <!-- A pill states one word about the run - its phase, its worker. The colour
         comes from the view model, because only it knows which word this is. -->
    <Style Selector="Border.pill">
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="Padding" Value="15,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The size lives here rather than on each pill, so they cannot drift apart. -->
    <Style Selector="Border.pill TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ── Tabs over the run ───────────────────────────────────────────────
         Buttons rather than a TabControl: each one binds its own "on" flag, so
         the strip and the panels below it read from the same index and nothing
         has to be kept in step by hand. The underline carries the selection.
    -->
    <Style Selector="Button.tab">
        <Setter Property="Padding" Value="2,7" />
        <Setter Property="Margin" Value="0,0,18,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.tab /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brand.TextMuted}" />
    </Style>
    <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.LineStrong}" />
        <Setter Property="Foreground" Value="{DynamicResource Brand.Text}" />
    </Style>
    <Style Selector="Button.tab:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- Last, so the selected tab keeps its underline while the pointer is over it. -->
    <Style Selector="Button.tab.on /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brand.Text}" />
    </Style>
    <Style Selector="Button.tab.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brand.Text}" />
    </Style>

    <!-- ── Status tiles ────────────────────────────────────────────────────
         Only counts the app actually holds: artifacts, tool calls, elapsed.
         No tile exists for a number we cannot honestly fill.
    -->
    <Style Selector="Border.tile">
        <Setter Property="Background" Value="{DynamicResource Brand.CardFill}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="TextBlock.tileValue">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brand.Text}" />
    </Style>
    <Style Selector="TextBlock.tileLabel">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource Brand.TextFaint}" />
        <Setter Property="Margin" Value="0,1,0,0" />
    </Style>

    <!-- ── A list of cards ─────────────────────────────────────────────────
         Runs, providers, workers: each row carries a coloured edge saying something
         true about it, and that edge has to be there BEFORE you click it - which is
         exactly what a selection-only marker cannot do. So the ListBoxItem gives up
         all its own chrome, including Fluent's flat grey ground, and the card inside
         it carries every state.
    -->
    <Style Selector="ListBox.cards">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.cards ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBox.cards ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="ListBox.cards ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.cards ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.cards ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource Brand.CardFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.LineStrong}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.card">
        <Setter Property="Background" Value="{DynamicResource Brand.CardFillHover}" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.card">
        <Setter Property="Background" Value="{DynamicResource Brand.CardFillActive}" />
    </Style>

    <Style Selector="TextBlock.cardTitle">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brand.Text}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.cardMeta">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Brand.TextMuted}" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ── The workspace card and its switcher ─────────────────────────────
         A workspace is recognised by its NAME. The path underneath it is trimmed
         from the FRONT, because the end is the part that tells one project from
         another - which is exactly what the old row of truncated path buttons got
         backwards.
    -->
    <Style Selector="Button.wsCard">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- The left edge is on a Border around the button, so it keeps the workspace's colour
         while Fluent repaints the button's own border on hover. -->
    <Style Selector="Button.wsCard /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand.CardFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Line}" />
        <Setter Property="BorderThickness" Value="0,1,1,1" />
        <Setter Property="CornerRadius" Value="0,5,5,0" />
    </Style>
    <Style Selector="Button.wsCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand.CardFillHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.LineStrong}" />
    </Style>
    <Style Selector="Button.wsCard Path">
        <Setter Property="Stroke" Value="{DynamicResource Brand.TextMuted}" />
        <Setter Property="StrokeThickness" Value="1.8" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>


    <Style Selector="Button.wsRow">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.wsRow /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0,4,4,0" />
    </Style>
    <!-- Over the row's own fill, so it has to be the next step up and not the same value. -->
    <Style Selector="Button.wsRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand.CardFillHover}" />
    </Style>
    <Style Selector="Button.wsRow:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand.CardFillActive}" />
    </Style>

    <!-- A small icon button living on a row: edit it, or remove it. Anything destructive
         adds .destructive and goes Danger on hover, never Ember - Ember is the action you
         are meant to take, and deleting something is not it. -->
    <Style Selector="Button.rowIcon">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.rowIcon /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.rowIcon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand.CardFill}" />
    </Style>
    <Style Selector="Button.rowIcon Path">
        <Setter Property="Stroke" Value="{DynamicResource Brand.TextFaint}" />
        <Setter Property="StrokeThickness" Value="1.7" />
        <Setter Property="StrokeLineCap" Value="Round" />
    </Style>
    <Style Selector="Button.rowIcon:pointerover Path">
        <Setter Property="Stroke" Value="{DynamicResource Brand.Text}" />
    </Style>
    <!-- Danger belongs to the one that destroys something; rename lights up like any other
         control. Declared LAST because Avalonia has no specificity - the last matching
         setter wins, so a more general rule after this one would undo it. -->
    <Style Selector="Button.rowIcon.destructive:pointerover Path">
        <Setter Property="Stroke" Value="{DynamicResource Brand.Danger}" />
    </Style>

    <!-- ── A settings section list ─────────────────────────────────────────
         Sections rather than tabs: a tab strip stops being readable somewhere
         around six, and a list has room for a group heading. Selection is marked
         the way it is everywhere else here - a tint and an ember edge, never a
         solid block.
    -->
    <Style Selector="Button.nav">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="CornerRadius" Value="0,4,4,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brand.TextMuted}" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand.CardFill}" />
        <Setter Property="Foreground" Value="{DynamicResource Brand.Text}" />
    </Style>
    <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand.CardFillHover}" />
    </Style>
    <!-- Last, so the section you are in keeps its edge while the pointer is over it. -->
    <Style Selector="Button.nav.on /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand.CardFillActive}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brand.Text}" />
    </Style>
    <Style Selector="Button.nav.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand.CardFillActive}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brand.Text}" />
    </Style>

</Styles>

