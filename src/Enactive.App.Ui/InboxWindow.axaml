<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Enactive.App.Ui"
        xmlns:vm="using:Enactive.App.Ui.ViewModels"
        xmlns:sys="using:System"
        x:Class="Enactive.App.Ui.InboxWindow"
        x:DataType="vm:InboxViewModel"
        Title="Enactive — Inbox"
        Width="1000" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brand.Bg}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True">

    <!-- OffScreenMargin keeps a MAXIMISED window inside the screen: with the client
         area extended over the decorations, the platform would otherwise push the edges
         a few pixels past the work area. -->
    <Grid RowDefinitions="Auto,*" Margin="{Binding $parent[Window].OffScreenMargin}">

        <local:TitleBarView Grid.Row="0" />

        <Panel Grid.Row="1">

        <DockPanel LastChildFill="True">

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="10,8">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Content="Mark all read" Command="{Binding MarkAllReadCommand}" />
                <CheckBox Content="Unread only" IsChecked="{Binding UnreadOnly}" VerticalAlignment="Center" />
                <TextBlock Classes="hint" Text="{Binding Status}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom" Classes="hint" Margin="10,4,10,8"
                       Text="{Binding WorkspaceRoot}" />

            <Grid ColumnDefinitions="360,*">

                <!-- What came in, newest first. -->
                <ListBox Grid.Column="0" Classes="cards" Margin="10,0,5,0"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:InboxItemViewModel">
                            <!-- The edge is what the item IS - a result, a decision nobody was there
                                 to answer, an error. The ember dot is the one thing that changes when
                                 you read it. -->
                            <Border Classes="card" BorderBrush="{Binding Kind, Converter={x:Static local:Palette.InboxKind}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                 Fill="{DynamicResource Brand.Accent}"
                                                 IsVisible="{Binding IsUnread}" />
                                        <TextBlock Text="{Binding Kind}" Foreground="{Binding Kind, Converter={x:Static local:Palette.InboxKind}}"
                                                   FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Classes="cardMeta" Text="{Binding When}"
                                                   Margin="0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="{Binding IsUnread, Converter={x:Static local:Palette.Bold}}"
                                               Foreground="{DynamicResource Brand.Text}"
                                               FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- The item, and the run that produced it. The item's own header is pinned: scrolling a
                     long timeline should never cost you the answer to "which item am I looking at". -->
                <DockPanel Grid.Column="1" Margin="5,0,10,0" IsVisible="{Binding HasSelection}">

                    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
                        <TextBlock Text="{Binding DetailTitle}" FontSize="16" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Classes="hint" Text="{Binding DetailMeta}" />
                        <TextBlock Text="{Binding DetailSummary}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brand.TextBody}" Margin="0,6,0,0" />

                        <!-- The question the run behind this item stopped at. The whole action is shown,
                             scrollable, above the buttons: nobody can consent to what they were not shown.
                             Answering carries the run on in the background. -->
                        <Border IsVisible="{Binding HasWaitingDecision}" Margin="0,10,0,0" Padding="10"
                                CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource Brand.Amber}">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="panelHeader" Text="WAITING FOR YOUR DECISION" />
                                <TextBlock Text="{Binding DecisionTopic}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Classes="hint" Text="{Binding DecisionAsked}" />
                                <ScrollViewer MaxHeight="220">
                                    <SelectableTextBlock Text="{Binding DecisionText}" TextWrapping="Wrap"
                                                         FontFamily="Consolas, Menlo, monospace" FontSize="12" />
                                </ScrollViewer>
                                <ItemsControl ItemsSource="{Binding DecisionOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WaitingAnswerViewModel">
                                            <Button Content="{Binding Label}" Command="{Binding Command}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <TextBlock Classes="hint" Text="{Binding DecisionStatus}" TextWrapping="Wrap"
                                   IsVisible="{Binding DecisionStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <ScrollViewer>
                      <StackPanel Spacing="4">

                        <TextBlock Classes="panelHeader" Text="RUN" />
                        <TextBlock Classes="hint" Text="{Binding RunHeader}" />

                        <ItemsControl ItemsSource="{Binding RunEvents}" Margin="0,6,0,0"
                                      IsVisible="{Binding HasRun}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RunEventViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                                        <TextBlock Text="{Binding When}" Classes="hint"
                                                   FontFamily="Consolas, Menlo, monospace" />
                                        <TextBlock Text="{Binding Kind}" Foreground="{Binding Tone, Converter={x:Static local:Palette.Timeline}}"
                                                   FontSize="11" Width="120" />
                                        <TextBlock Text="{Binding Summary}" Foreground="{Binding Tone, Converter={x:Static local:Palette.Timeline}}"
                                                   FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="panelHeader" Text="ARTIFACTS" Margin="0,12,0,0"
                                   IsVisible="{Binding HasRun}" />
                        <ItemsControl ItemsSource="{Binding RunArtifacts}" IsVisible="{Binding HasRun}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="sys:String">
                                    <TextBlock Text="{Binding}" FontFamily="Consolas, Menlo, monospace"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="panelHeader" Text="DECISIONS" Margin="0,12,0,0"
                                   IsVisible="{Binding HasRun}" />
                        <ItemsControl ItemsSource="{Binding RunDecisions}" IsVisible="{Binding HasRun}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="sys:String">
                                    <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="12" />

                      </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </DockPanel>
        </Panel>
    </Grid>

</Window>
