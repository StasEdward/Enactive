<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Enactive.App.Ui.ViewModels"
        xmlns:sys="using:System"
        x:Class="Enactive.App.Ui.InboxWindow"
        x:DataType="vm:InboxViewModel"
        Title="Enactive — Inbox"
        Width="1000" Height="640">

    <DockPanel LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="10,8">
            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
            <Button Content="Mark all read" Command="{Binding MarkAllReadCommand}" />
            <CheckBox Content="Unread only" IsChecked="{Binding UnreadOnly}" VerticalAlignment="Center" />
            <TextBlock Classes="hint" Text="{Binding Status}" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Classes="hint" Margin="10,4,10,8"
                   Text="{Binding WorkspaceRoot}" />

        <Grid ColumnDefinitions="360,*">

            <!-- What came in, newest first. -->
            <ListBox Grid.Column="0" Margin="10,0,5,0"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:InboxItemViewModel">
                        <StackPanel Margin="0,3">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="●" Foreground="{DynamicResource Brand.Accent}"
                                           FontSize="11" VerticalAlignment="Center"
                                           IsVisible="{Binding IsUnread}" />
                                <TextBlock Text="{Binding Kind}" Foreground="{Binding KindBrush}"
                                           FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Classes="hint" Text="{Binding When}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="{Binding TitleWeight}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- The item, and the run that produced it. -->
            <ScrollViewer Grid.Column="1" Margin="5,0,10,0" IsVisible="{Binding HasSelection}">
                <StackPanel Spacing="4">

                    <TextBlock Text="{Binding DetailTitle}" FontSize="16" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Classes="hint" Text="{Binding DetailMeta}" />
                    <TextBlock Text="{Binding DetailSummary}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brand.TextBody}" Margin="0,6,0,0" />

                    <TextBlock Classes="panelHeader" Text="RUN" Margin="0,12,0,0" />
                    <TextBlock Classes="hint" Text="{Binding RunHeader}" />

                    <ItemsControl ItemsSource="{Binding RunEvents}" Margin="0,6,0,0"
                                  IsVisible="{Binding HasRun}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RunEventViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                                    <TextBlock Text="{Binding When}" Classes="hint"
                                               FontFamily="Consolas, Menlo, monospace" />
                                    <TextBlock Text="{Binding Kind}" Foreground="{Binding Brush}"
                                               FontSize="11" Width="120" />
                                    <TextBlock Text="{Binding Summary}" Foreground="{Binding Brush}"
                                               FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Classes="panelHeader" Text="ARTIFACTS" Margin="0,12,0,0"
                               IsVisible="{Binding HasRun}" />
                    <ItemsControl ItemsSource="{Binding RunArtifacts}" IsVisible="{Binding HasRun}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                                <TextBlock Text="{Binding}" FontFamily="Consolas, Menlo, monospace"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Classes="panelHeader" Text="DECISIONS" Margin="0,12,0,0"
                               IsVisible="{Binding HasRun}" />
                    <ItemsControl ItemsSource="{Binding RunDecisions}" IsVisible="{Binding HasRun}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                                <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="12" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
