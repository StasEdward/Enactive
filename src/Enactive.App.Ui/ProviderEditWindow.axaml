<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Enactive.App.Ui"
        xmlns:vm="using:Enactive.App.Ui.ViewModels"
        x:Class="Enactive.App.Ui.ProviderEditWindow"
        x:DataType="vm:ProviderEditViewModel"
        Title="Provider"
        Width="1040" Height="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brand.Bg}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True">

    <!-- OffScreenMargin keeps a MAXIMISED window inside the screen: with the client
         area extended over the decorations, the platform would otherwise push the edges
         a few pixels past the work area. -->
    <Grid RowDefinitions="Auto,*" Margin="{Binding $parent[Window].OffScreenMargin}">

        <local:TitleBarView Grid.Row="0" />

        <Panel Grid.Row="1">

        <ScrollViewer>
            <StackPanel Classes="form">

                <!-- Two columns, which kept every field and halved the height: on the left, where the provider is and how to
                     reach it; on the right, how a model of it is used. One column of twenty fields needed a scroll to reach
                     the models list, which is the field everybody comes here for. A field only one kind of provider reads is
                     shown for that kind only (ProviderEditViewModel.Shows*). -->
                <Grid ColumnDefinitions="*,24,*">

                    <StackPanel x:Name="ConnectionColumn" Grid.Column="0" Spacing="6">
                        <TextBlock Classes="panelHeader" Text="CONNECTION" />

                        <TextBlock Classes="label" Text="Id" />
                        <TextBox Text="{Binding Id}"
                                 PlaceholderText="e.g. ollama, anthropic, openrouter (used in providerId/model)" />

                        <TextBlock Classes="label" Text="Kind" />
                        <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" HorizontalAlignment="Stretch" />

                        <TextBlock Classes="label" Text="Base URL" />
                        <TextBox Text="{Binding BaseUrl}" PlaceholderText="e.g. http://localhost:11434/v1" />

                        <TextBlock Classes="label" Text="API key" />
                        <TextBox Text="{Binding ApiKey}" PasswordChar="•"
                                 PlaceholderText="blank for local providers" />

                        <TextBlock Classes="label" Text="Headers" />
                        <TextBox Classes="multiline" MinHeight="60" Text="{Binding HeadersText}"
                                 PlaceholderText="extra headers — one Header-Name: value per line" />

                        <TextBlock Classes="label" Text="Models" />
                        <TextBox Classes="multiline" MinHeight="120" Text="{Binding ModelsText}"
                                 PlaceholderText="models — one per line" />

                        <!-- Ask the provider what it actually serves, then pick one to add to the list above. -->
                        <Grid ColumnDefinitions="*,Auto">
                            <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding FetchedModels}"
                                      SelectedItem="{Binding SelectedFetchedModel}"
                                      PlaceholderText="fetched models…" />
                            <Button Grid.Column="1" Margin="8,0,0,0"
                                    Content="Fetch" Command="{Binding FetchCommand}" />
                        </Grid>

                        <!-- Test asks the provider whether it is there AND whether it has the first model
                             listed above. A status check alone cannot see the commonest failure of a setup
                             that used to work: the server is up, the key is fine, and the model was never
                             pulled. The light beside the line is the answer, and it is grey until asked. -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Test" Command="{Binding TestCommand}"
                                    ToolTip.Tip="Ask this provider for its model list, and check that the first model above is among them" />
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                     Fill="{Binding Health, Converter={x:Static local:Palette.Health}}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="ModelColumn" Grid.Column="2" Spacing="6">
                        <TextBlock Classes="panelHeader" Text="MODEL" />

                        <TextBlock Classes="label" Text="Context window (tokens)" />
                        <TextBox Text="{Binding ContextWindowText}"
                                 PlaceholderText="blank = assume 16000 — nothing can ask the provider" />

                        <TextBlock Classes="label" Text="Hand a step over at" />
                        <TextBox Text="{Binding HandoverText}"
                                 PlaceholderText="75% of the window, 80000 tokens, or both; blank = after 60 turns" />

                        <TextBlock Classes="label" Text="Tokens kept free for the answer" />
                        <TextBox Text="{Binding AnswerReserveText}"
                                 PlaceholderText="blank = an eighth of the context window" />

                        <TextBlock Classes="label" Text="Max output tokens" />
                        <TextBox Text="{Binding MaxTokensText}"
                                 PlaceholderText="blank = auto (adjusts to the model's cap)" />

                        <TextBlock Classes="label" Text="Extra generation tokens for reasoning" />
                        <TextBox Text="{Binding ReasoningAllowanceText}" PlaceholderText="blank = profile default; 0 = no extra allowance" />

                        <TextBlock Classes="label" Text="Temperature" />
                        <TextBox Text="{Binding TemperatureText}"
                                 PlaceholderText="blank = the engine's (0.2 worker, 0 review); a number; server = the server's own" />

                        <TextBlock Classes="label" Text="Effort (low, medium, high, xhigh, max)" IsVisible="{Binding ShowsEffort}" />
                        <TextBox Text="{Binding EffortText}" PlaceholderText="blank = the model's default (Sonnet 5: high)"
                                 IsVisible="{Binding ShowsEffort}" />

                        <TextBlock Classes="label" Text="Keep the model loaded (seconds)" IsVisible="{Binding ShowsKeepAlive}" />
                        <TextBox Text="{Binding OllamaKeepAliveText}" PlaceholderText="blank = server default; 0 = unload; -1 = keep resident"
                                 IsVisible="{Binding ShowsKeepAlive}" />

                        <CheckBox IsChecked="{Binding OpenAiReasoningProfile}" IsVisible="{Binding ShowsOpenAiOptions}"
                                  Content="OpenAI reasoning compatibility (developer role, no temperature)" />
                        <CheckBox IsChecked="{Binding SendReasoningBack}" IsVisible="{Binding ShowsOpenAiOptions}"
                                  Content="Send the model's reasoning back with its earlier turns (Qwen3.6 preserve_thinking, llama.cpp --reasoning-preserve)" />

                        <Grid ColumnDefinitions="*,12,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="label" Text="Stream idle timeout (s)" />
                                <TextBox Text="{Binding StreamIdleTimeoutText}" PlaceholderText="300" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="label" Text="Non-streaming timeout (s)" />
                                <TextBox Text="{Binding CompletionTimeoutText}" PlaceholderText="900" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>

                <TextBlock Classes="hint" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" />

                <!-- "Apply", not "Save", because this button does not write anything: it puts
                     the change into the Settings window's copy, and that copy reaches the file only
                     when Settings itself is saved. Reported 2026-09-23 - a tool was ticked here
                     twice, across two restarts, and lost both times. A button labelled Save that
                     does not save is the defect; the label was it. -->
                <StackPanel Classes="actions">
                    <Button Classes="primary" Content="Apply" Command="{Binding SaveCommand}" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}" />
                </StackPanel>
                <TextBlock Classes="hint" TextWrapping="Wrap"
                           Text="Apply puts this back in the Settings window. It is written to disk when you press Save there - closing Settings without saving discards it." />

            </StackPanel>
        </ScrollViewer>
        </Panel>
    </Grid>

</Window>
