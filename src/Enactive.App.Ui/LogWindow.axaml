<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Enactive.App.Ui.ViewModels"
        x:Class="Enactive.App.Ui.LogWindow"
        x:DataType="vm:LogWindowViewModel"
        Title="Enactive — Global Log"
        Width="1040" Height="680">

    <Grid RowDefinitions="Auto,Auto,*,190,Auto">

        <!-- Toolbar -->
        <WrapPanel Grid.Row="0" Margin="8,6,8,4">
            <TextBlock Text="Level ≥" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Width="110" ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}" />
            <Border Width="14" />
            <CheckBox Content="Capture raw wire (Trace)" IsChecked="{Binding CaptureRaw}" />
            <Border Width="14" />
            <TextBox Width="200" Text="{Binding SearchText}" Watermark="search… (#2 = one step)" />
            <Border Width="14" />
            <CheckBox Content="Auto-scroll" IsChecked="{Binding AutoScroll}" />
            <CheckBox Content="Pause" IsChecked="{Binding Pause}" />
            <Button Content="Clear" Command="{Binding ClearCommand}" />
            <Button Content="Export" Command="{Binding ExportCommand}" />
        </WrapPanel>

        <!-- Which planes of the log to show. Filtering here never changes what is recorded. -->
        <WrapPanel Grid.Row="1" Margin="8,0,8,4">
            <TextBlock Text="Sources:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ItemsControl ItemsSource="{Binding Sources}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SourceToggle">
                        <ToggleButton Content="{Binding Name}"
                                      IsChecked="{Binding IsEnabled}"
                                      FontSize="11"
                                      Padding="6,2"
                                      Margin="2,0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </WrapPanel>

        <ListBox Grid.Row="2" Margin="8,0"
                 x:Name="RowList"
                 ItemsSource="{Binding Rows}"
                 SelectedItem="{Binding SelectedRow}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LogRow">
                    <TextBlock Text="{Binding Line}"
                               Foreground="{Binding Brush}"
                               FontFamily="Consolas, Menlo, monospace"
                               FontSize="12"
                               TextWrapping="NoWrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3" Margin="0,6,0,0"
                BorderBrush="{DynamicResource Brand.Line}" BorderThickness="0,1,0,0" Padding="8,6,8,0">
            <TextBox IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas, Menlo, monospace"
                     FontSize="12"
                     Text="{Binding DetailText}"
                     Watermark="Select a row to see its full payload (prompt / response / arguments)…" />
        </Border>

        <TextBlock Grid.Row="4" Classes="hint" Margin="8,2,8,4" Text="{Binding Status}" />
    </Grid>
</Window>
