<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Secrets at rest, on their own, away from the UI. They were a file inside the Avalonia project,
    which made the one piece of security-relevant code in this repo the one piece that could not be
    tested: the test suite cannot reference a desktop app it would then have to build, and building
    it fails whenever the app is running. A tiny library with no UI dependency has neither problem.
  -->
  <PropertyGroup>
    <RootNamespace>Enactive.Secrets</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

</Project>
