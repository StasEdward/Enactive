<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Enactive.Server</RootNamespace>
    <AssemblyName>Enactive.Server</AssemblyName>
  </PropertyGroup>

  <!--
    Enactive as a Windows service on the local network, with a web UI (ADR 0002). A fourth host: it composes
    every run through RunComposer and keeps only what a host keeps - who answers a decision (a person in a
    browser), where the events go, cancellation. What it does around a run is Enactive.Application's, shared
    with the window; nothing here may grow a second copy of it.

    Windows only: the secrets it runs with are DPAPI-protected for its account (ADR 0002 §7), and it runs as a
    Windows service.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.7" />
    <!-- server.db: the accounts and the audit log. The version the workspace stores already use. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <ProjectReference Include="..\Enactive.Application\Enactive.Application.csproj" />
    <ProjectReference Include="..\Enactive.Secrets\Enactive.Secrets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Enactive.Server.Tests" />
    <InternalsVisibleTo Include="ServerHarness" />
  </ItemGroup>

  <ItemGroup>
    <!-- The brand - palette, type, marks - is the gateway's wwwroot/brand, served here at /brand by link, not copied:
         a copy is a second palette, and the second one is the one nobody updates.
         ContentRoot says where the files are: without it the SDK records a linked file as under THIS wwwroot, and a
         service run from the build (dotnet run, Visual Studio) answered /brand/brand.css with 200 and nothing in it -
         every page unstyled. A publish copies the files and never showed it (StaticAssetsTests). -->
    <Content Include="..\Enactive.Remote.Gateway\wwwroot\brand\**" LinkBase="wwwroot\brand"
             ContentRoot="$(MSBuildProjectDirectory)\..\Enactive.Remote.Gateway\wwwroot\" />
  </ItemGroup>

</Project>
