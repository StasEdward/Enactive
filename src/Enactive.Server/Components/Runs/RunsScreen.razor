@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Viewer")]
@using Enactive.Server.Runs
@using Microsoft.AspNetCore.Components.Authorization
@inject IRunControl Runs
@inject ServerHistory History
@inject WorkspaceIds Ids
@inject NavigationManager Navigation

<PageTitle>Enactive</PageTitle>

@* The Runs screen, as the main window: the workspace and runs column on the left, the run on the right. It replaces the
   old pages piece by piece and leaves no gap meanwhile: until the command bar and the live run are built, the main area
   holds what the start page held - its start form and its list of runs - unchanged, so starting and finding a run keep
   working while the rest is rebuilt. *@

<div class="runs-screen">
    <WorkspaceColumn WorkspaceId="_wanted" Said="@Said" />

    <section class="runs-main">
        @* Live, like every page, and drawn only once its connection is up (App.razor): a live page drawn before that showed
           a form whose text was lost - the run was started with an empty folder, or the form went off as a GET (found by
           tests/server-e2e). The start form is submitted over the connection; method="post" stays so that a form the
           browser ever sent itself would not put the task in an address. *@
        <AuthorizeView Policy="Operator">
            <EditForm Model="_input" method="post" OnValidSubmit="StartAsync" class="start" Context="form">
                <label>Workspace
                    <InputSelect @bind-Value="_input.Workspace">
                        @foreach (var workspace in _workspaces)
                        {
                            <option value="@workspace.RootPath">@workspace.Name - @workspace.RootPath</option>
                        }
                    </InputSelect>
                </label>
                <label>Task <InputTextArea @bind-Value="_input.Task" rows="3" /></label>
                <button type="submit">Run</button>
                @if (_said is not null)
                {
                    <p class="said" role="alert">@_said</p>
                }
            </EditForm>
        </AuthorizeView>

        @if (_runs.Count == 0)
        {
            <p>No runs yet.</p>
        }
        else
        {
            <ul class="list">
                @foreach (var run in _runs)
                {
                    <li>
                        <a href="@($"runs/{run.Id}")">@RunState.Title(run)</a>
                        <span class="state">@RunState.Of(run)</span>
                        <span class="where">@run.Workspace · @run.Owner · @run.StartedAt.ToString("HH:mm")</span>
                    </li>
                }
            </ul>
        }
    </section>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> Auth { get; set; } = default!;

    /// <summary>
    /// The workspace, by its id (WorkspaceIds). Read as text and parsed here: an address is typed by people, and one
    /// that is not an id must say "not known" rather than fail the page.
    /// </summary>
    [SupplyParameterFromQuery(Name = "ws")] private string? Ws { get; set; }

    /// <summary>What an action that came back here said - the old history page's actions, a folder just added.</summary>
    [SupplyParameterFromQuery] private string? Said { get; set; }

    private Guid? _wanted;
    private readonly StartForm _input = new();
    private string? _said;
    private IReadOnlyList<ServerRun> _runs = [];
    private IReadOnlyList<Enactive.Workspace.WorkspaceEntry> _workspaces = [];
    private string? _shownWorkspace;

    private sealed class StartForm
    {
        public string Workspace { get; set; } = "";
        public string Task { get; set; } = "";
    }

    // Read per address, not once: see Pages/_Imports.razor.
    protected override async Task OnParametersSetAsync()
    {
        var user = (await Auth).User;
        // An id that does not parse names no workspace (Guid.Empty is no folder's), rather than the one used last.
        _wanted = Ws is { Length: > 0 } ? Guid.TryParse(Ws, out var id) ? id : Guid.Empty : null;

        _runs = Runs.List(user);
        // The folders the service knows; a new one is added by browsing its roots (Add folder…), not typed.
        _workspaces = History.Workspaces(user);
        // The start form runs in the workspace the column shows, as the window's command bar does - set again when the
        // column moves to another one, and left alone while it stays, so a folder picked in the form is not taken back.
        var shown = WorkspaceColumnState.Choose(_workspaces, _wanted, Ids)?.RootPath ?? _workspaces.FirstOrDefault()?.RootPath ?? "";
        if (shown != _shownWorkspace)
            (_input.Workspace, _shownWorkspace) = (shown, shown);
    }

    private async Task StartAsync()
    {
        var (run, refusal) = Runs.Start((await Auth).User, _input.Workspace, _input.Task);
        if (run is null)
        {
            _said = refusal;
            return;
        }
        Navigation.NavigateTo($"runs/{run.Id}");
    }
}
