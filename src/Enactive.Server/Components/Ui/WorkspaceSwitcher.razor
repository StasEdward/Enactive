@using Enactive.Application.Projections
@using Enactive.Server.Components.Runs

@* The window's WORKSPACE card and its popup (MainWindow.axaml): the folder you are in, and on a click every workspace the
   service knows, each with its edge - blue where you are, red where the folder is gone, grey else (Looks.Workspace) -
   and Add workspace…. Choosing one is a link to the Runs screen on it, by its id: an address, so it can be opened in
   another tab and comes back on reload. Where the page lets this person, each row has the window's Rename and Forget
   beside it (WorkspaceRows' words); the page asks and the service does it. *@

<div class="switcher-anchor">
    @if (Current is { } current)
    {
        @* Named for what it is and where you are: read from its content it was the folder's name and its whole path,
           which says neither that this is the workspace nor that it opens the others. *@
        <button type="button" class="@("ws-card edge " + Looks.Workspace(current.Place))"
                aria-label="@($"Workspace: {current.Entry.Name}")" title="@current.Entry.RootPath"
                aria-haspopup="true" aria-expanded="@_open" @onclick="Toggle">
            <span class="ws-card-text">
                <span class="@(current.Exists ? "ws-name" : "ws-name missing")">@current.Entry.Name</span>
                <span class="path">@current.Entry.RootPath</span>
            </span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M 7,10 L 12,15 L 17,10" /></svg>
        </button>
    }
    else
    {
        @* No workspace to show - none known yet, or the address named one the service does not know: the card still opens
           the list, which is how one is chosen or added. *@
        <button type="button" class="ws-card edge edge-other" aria-haspopup="true" aria-expanded="@_open" @onclick="Toggle">
            <span class="ws-card-text"><span class="ws-name">Choose a folder</span></span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M 7,10 L 12,15 L 17,10" /></svg>
        </button>
    }

    @if (_open)
    {
        @* Clicking away closes it, as the window's light dismiss does. *@
        <div class="switcher-away" @onclick="Close"></div>
        <div class="switcher popup">
            <h2 class="panel-header">WORKSPACES</h2>
            @if (Rows.Count == 0)
            {
                <p class="hint">The service knows no folder yet.@(OnAdd.HasDelegate ? " Add one under its roots." : " An Operator adds one.")</p>
            }
            <ul class="ws-rows">
                @foreach (var row in Rows)
                {
                    <li class="@("ws-row edge " + Looks.Workspace(row.Place) + (row.IsCurrent ? " current" : ""))">
                        <a href="@Href(row)" @onclick="Close" aria-current="@(row.IsCurrent ? "true" : null)">
                            <span class="@(row.Exists ? "ws-name" : "ws-name missing")">@row.Entry.Name</span>
                            <span class="@(row.Exists ? "path" : "path missing")">@row.Detail</span>
                        </a>
                        @if (OnRename.HasDelegate)
                        {
                            <button type="button" class="row-icon ws-rename" title="@WorkspaceRows.RenameTip"
                                    aria-label="@($"Rename {row.Entry.Name}")" @onclick="() => ActAsync(OnRename, row)">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                                    <path d="M 4,20 L 4,16 L 15.5,4.5 L 19.5,8.5 L 8,20 Z" />
                                    <path d="M 13.5,6.5 L 17.5,10.5" />
                                </svg>
                            </button>
                        }
                        @if (OnForget.HasDelegate)
                        {
                            <button type="button" class="row-icon destructive ws-forget" title="@WorkspaceRows.ForgetTip"
                                    aria-label="@($"Forget {row.Entry.Name}")" @onclick="() => ActAsync(OnForget, row)">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                                    <path d="M 6,6 L 18,18 M 18,6 L 6,18" />
                                </svg>
                            </button>
                        }
                    </li>
                }
            </ul>
            @if (OnAdd.HasDelegate)
            {
                <button type="button" class="btn add-folder" @onclick="AddAsync">Add workspace…</button>
            }
        </div>
    }
</div>

@code {
    private bool _open;

    [Parameter, EditorRequired] public IReadOnlyList<SwitcherRow> Rows { get; set; } = [];
    [Parameter] public SwitcherRow? Current { get; set; }
    [Parameter, EditorRequired] public Func<SwitcherRow, string> Href { get; set; } = _ => "/";

    /// <summary>Add workspace… - offered only when set (an Operator's; the service refuses it for anybody else).</summary>
    [Parameter] public EventCallback OnAdd { get; set; }

    /// <summary>A row's Rename - offered only when set (an Operator's; the service refuses it for anybody else).</summary>
    [Parameter] public EventCallback<SwitcherRow> OnRename { get; set; }

    /// <summary>A row's Forget - offered only when set (an Operator's; the service refuses it for anybody else).</summary>
    [Parameter] public EventCallback<SwitcherRow> OnForget { get; set; }

    /// <summary>The list closes and the page asks: its question is over the page, not under a popup.</summary>
    private async Task ActAsync(EventCallback<SwitcherRow> act, SwitcherRow row)
    {
        _open = false;
        await act.InvokeAsync(row);
    }

    private void Toggle() => _open = !_open;

    private void Close() => _open = false;

    private async Task AddAsync()
    {
        _open = false;
        await OnAdd.InvokeAsync();
    }
}
