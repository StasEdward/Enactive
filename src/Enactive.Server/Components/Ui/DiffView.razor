@using Enactive.Application.Projections

@* A unified diff, each line in what it does to the file (DiffLines, Looks.Diff): added green, removed red, the rest
   muted - the window's staged change opened. Text, never markup: a diff is a workspace's content, whatever it holds. *@

<div class="@(Numbered ? "diff numbered" : "diff")" role="region" aria-label="Changes">
    @if (Numbered)
    {
        @* Each line with its numbers in the file as it was and as it is (DiffLines.Numbered, the window's rule too) -
           beside the line, never in it: the line is the diff's own text, what is read and copied. Hidden from a screen
           reader, which reads the +/- of the line. *@
        foreach (var line in DiffLines.Numbered(Diff))
        {
            <div class="diff-row">
                <span class="diff-num" aria-hidden="true">@Number(line.Old)</span><span class="diff-num" aria-hidden="true">@Number(line.New)</span>
                <div class="@("diff-line " + Looks.Diff(line.Kind))">@line.Text</div>
            </div>
        }
    }
    else
    {
        @foreach (var line in DiffLines.Split(Diff))
        {
            <div class="@("diff-line " + Looks.Diff(DiffLines.Kind(line)))">@line</div>
        }
    }
</div>

@code {
    /// <summary>The diff as TextDiff.Unified writes it.</summary>
    [Parameter, EditorRequired] public string Diff { get; set; } = "";

    /// <summary>Line numbers beside the lines (a review's diff); the staged previews keep theirs bare.</summary>
    [Parameter] public bool Numbered { get; set; }

    private static string Number(int? n) => n?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
}
