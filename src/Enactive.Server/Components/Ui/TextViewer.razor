@using Microsoft.JSInterop
@inject IJSRuntime JS

@* The window's viewer (ViewerWindow), in a dialog on the screen: a file, a report, an analysis - its own text, read-only,
   monospaced and never wrapped, because those are reports whose columns mean something. Copy all hands over the text
   itself, never what a rendering made of it. Source shows only where there is something to switch between: a caller's
   rendering of the text, which must never be the only way to read it - whatever it did not understand is readable as
   the source. *@

<Dialog Title="@Title" OnClose="OnClose">
    <ChildContent>
        @if (Problem is { Length: > 0 })
        {
            <p class="said">@Problem</p>
        }
        else if (Rendered is not null && !_source)
        {
            <div class="viewer-rendered">@Rendered</div>
        }
        else
        {
            <pre class="viewer-text">@Text</pre>
        }
    </ChildContent>
    <Actions>
        @if (_copied)
        {
            <span class="hint viewer-status">Copied.</span>
        }
        @if (Rendered is not null && Problem is null)
        {
            <button type="button" class="@(_source ? "btn on" : "btn")" aria-pressed="@(_source ? "true" : "false")"
                    title="Show the file exactly as it is on disk." @onclick="() => _source = !_source">Source</button>
        }
        @if (Problem is null)
        {
            <button type="button" class="btn" @onclick="CopyAsync">Copy all</button>
        }
        <button type="button" class="btn" @onclick="OnClose">Close</button>
    </Actions>
</Dialog>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>The text, as it is: what is shown as source and what Copy all hands over.</summary>
    [Parameter] public string Text { get; set; } = "";

    /// <summary>Why there is no text to show - the file gone, too big, not text - or null.</summary>
    [Parameter] public string? Problem { get; set; }

    /// <summary>The caller's rendering of the text, when it has one; with it, Source switches to the text itself.</summary>
    [Parameter] public RenderFragment? Rendered { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private bool _source;
    private bool _copied;

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Text);
            _copied = true;
        }
        catch (JSException)
        {
            // The browser refused the clipboard (not a secure page, permission denied): the text is still there to select.
            _copied = false;
        }
    }
}
