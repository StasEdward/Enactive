@* The window's row icons on a card (Button.rowIcon, SettingsWindow.axaml): a pencil to edit, a cross to remove, quiet
   until pointed at - the buttons are on the card, so nothing has to be selected first to act on the thing pointed at.
   Each is named for the row it acts on: a list of "Edit" buttons read aloud says nothing about which. *@

<span class="row-icons">
    <button type="button" class="row-icon" title="Edit" aria-label="@($"Edit {Of}")" @onclick="Edit">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M 4,20 L 4,16 L 15.5,4.5 L 19.5,8.5 L 8,20 Z" />
            <path d="M 13.5,6.5 L 17.5,10.5" />
        </svg>
    </button>
    @if (Remove.HasDelegate)
    {
        <button type="button" class="row-icon destructive" title="@RemoveTip" aria-label="@($"{RemoveTip} {Of}")" @onclick="Remove">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path d="M 6,6 L 18,18 M 18,6 L 6,18" />
            </svg>
        </button>
    }
</span>

@code {
    [Parameter, EditorRequired] public EventCallback Edit { get; set; }
    [Parameter] public EventCallback Remove { get; set; }

    /// <summary>The row's name, for each button's accessible name.</summary>
    [Parameter, EditorRequired] public string Of { get; set; } = "";

    [Parameter] public string RemoveTip { get; set; } = "Remove";
}
