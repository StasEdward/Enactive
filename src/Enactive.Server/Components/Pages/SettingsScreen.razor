@page "/settings"
@page "/settings/{Section}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Admin")]
@using System.Collections.Specialized
@using System.ComponentModel
@using Enactive.Application
@using Enactive.Server.Components.Runs
@using Enactive.Server.Components.Settings
@using Enactive.Server.Components.Ui
@using Enactive.Server.Runs
@using Enactive.Settings
@using Enactive.Tools.Mcp
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject ServerSettings Service
@inject ServerHistory History
@inject WorkspaceIds Ids
@inject ChosenWorkspace Chosen

<PageTitle>Settings - Enactive</PageTitle>

@* The window's Settings (SettingsWindow.axaml): the sections on the left, the one chosen on the right, Save and Cancel
   at the bottom. What it shows and decides is the window's own view model (SettingsViewModel), built by ServerSettings
   over a copy of the service's settings that holds no secret: a key, the mail password or an MCP token never reaches
   this page, not even as the value of a box - the page says whether one is kept, takes a new one, and removes one only
   when told to. Its Save comes back to ServerSettings as the person, which checks the role and the file's version
   again.

   One copy for every section, as the window has: going to another section keeps what was changed in this one, Save
   writes them all, Cancel drops them all and opens the settings again. Each section has its own address
   (/settings/ai-providers), so a link or a reload lands where it was. *@

<div class="settings-screen">
    @if (_problem is { } problem)
    {
        <p class="said">@problem</p>
    }
    else if (_vm is { } vm)
    {
        <nav class="settings-nav" aria-label="Settings sections">
            @foreach (var section in SettingsSection.All.Where(s => !s.UnderAi))
            {
                @NavItem(section)
            }
            <div class="settings-nav-rule"></div>
            <p class="panel-header settings-nav-group">AI</p>
            @foreach (var section in SettingsSection.All.Where(s => s.UnderAi))
            {
                @NavItem(section)
            }
        </nav>

        @* The view model goes down as a cascading value: it is internal to the application layer, and a component's
           parameters are public. *@
        <section class="settings-pane" aria-label="@PaneName">
            <CascadingValue Value="vm">
                @switch (_section.Slug)
                {
                    case "general": <GeneralSection /> break;
                    case "writable-folders": <WritableFoldersSection Roots="_roots" /> break;
                    case "smtp": <SmtpSection /> break;
                    case "web": <WebSection /> break;
                    case "about": <AboutSection /> break;
                    case "ai-general": <AiGeneralSection /> break;
                    case "ai-providers": <ProvidersSection /> break;
                    case "ai-team": <TeamSection /> break;
                    case "ai-phases": <PhasesSection /> break;
                    case "ai-mcp": <McpSection /> break;
                    case "ai-templates": <TemplatesSection Workspace="_templatesWorkspace" Root="@_templatesRoot" /> break;
                    case "ai-checks": <ChecksSection Workspace="_templatesWorkspace" Root="@_templatesRoot" /> break;
                }
            </CascadingValue>
        </section>

        @* At the bottom, under every section, as the window has them: what a Save could not do, then Save and Cancel. *@
        <div class="settings-foot">
            @if (vm.HasStartupNote)
            {
                <p class="hint settings-note" role="alert">@vm.StartupNote</p>
            }
            @if (_said is { } said)
            {
                <p class="hint settings-said" role="status">@said</p>
            }
            <div class="settings-actions">
                <button type="button" class="btn primary" disabled="@(!vm.SaveCommand.CanExecute(null))" @onclick="SaveAsync">Save</button>
                <button type="button" class="btn" @onclick="Cancel">Cancel</button>
            </div>
        </div>
    }
</div>

@if (_question is { } question)
{
    <Dialog Title="@question.Headline" OnClose="() => Answer(false)">
        <ChildContent><p class="body">@question.Detail</p></ChildContent>
        <Actions>
            <button type="button" class="btn destructive" @onclick="() => Answer(true)">Remove</button>
            <button type="button" class="btn" @onclick="() => Answer(false)">Keep</button>
        </Actions>
    </Dialog>
}

@if (_providerEditor is { } providerEditor)
{
    <CascadingValue Value="providerEditor"><ProviderEditor /></CascadingValue>
}

@if (_workerEditor is { } workerEditor)
{
    <CascadingValue Value="workerEditor"><WorkerEditor /></CascadingValue>
}

@if (_mcpEditor is { } mcpEditor)
{
    <McpEditor Draft="mcpEditor.Draft" Saved="@(draft => { mcpEditor.Saved(draft); WriteNow(); })" OnClose="() => _mcpEditor = null" />
}

@code {
    [CascadingParameter] private Task<AuthenticationState> Auth { get; set; } = default!;

    /// <summary>The section, by its address (SettingsSection); none or one that is not a section, the first.</summary>
    [Parameter] public string? Section { get; set; }

    private SettingsViewModel? _vm;
    private SettingsSection _section = SettingsSection.All[0];
    private string? _problem;
    private string? _said;
    private IReadOnlyList<string> _roots = [];
    private Guid? _templatesWorkspace;
    private string? _templatesRoot;

    private (string Headline, string Detail, TaskCompletionSource<bool> Answer)? _question;
    private ProviderEditViewModel? _providerEditor;
    private WorkerEditViewModel? _workerEditor;
    private (McpServerConfig Draft, Action<McpServerConfig> Saved)? _mcpEditor;

    private string PaneName => _section.UnderAi ? "AI · " + _section.Label : _section.Label;

    protected override async Task OnInitializedAsync() => await OpenAsync();

    // Read per address (Pages/_Imports.razor): another section is a link to this same page, which keeps the copy being
    // edited and only shows another part of it.
    protected override void OnParametersSet()
    {
        _section = SettingsSection.Find(Section);
        if (_vm is not null)
            _section.Show(_vm).Execute(null);
    }

    /// <summary>
    /// The settings as they are on disk, opened for this person: on arrival, after a save (the file has a new version),
    /// and on Cancel (what was changed is dropped).
    /// </summary>
    private async Task OpenAsync()
    {
        var user = (await Auth).User;
        // The workspace the Templates screen opens on, whose templates the Templates section lists with the global ones.
        var known = History.Workspaces(user);
        var workspace = WorkspaceColumnState.Choose(known, Chosen.Wanted(null, known, Ids, user), Ids);
        _templatesWorkspace = workspace is null ? null : Ids.TryIdOf(workspace.RootPath);
        _templatesRoot = workspace?.RootPath;

        var (vm, problem) = Service.Edit(user, workspace?.RootPath, said => _said = said);
        _problem = problem;
        _roots = Service.WorkspaceRoots(user).Roots ?? [];
        Show(vm);
        if (vm is not null)
            _section.Show(vm).Execute(null);
    }

    private async Task SaveAsync()
    {
        _said = null;
        // A save made says itself and closes the view model (CloseRequested), which opens the settings again; a refusal
        // is the view model's StartupNote, under the sections, and keeps every change for another try.
        if (_vm is { } vm)
            await vm.SaveCommand.ExecuteAsync();
    }

    private void Cancel()
    {
        _said = null;
        _vm?.CancelCommand.Execute(null);
    }

    /// <summary>
    /// The view model drawn: what changes in it is drawn again (INotifyPropertyChanged, and its lists), not only on the
    /// next event from this page - a provider's light that turns once its answer comes, a list a dialog added to.
    /// </summary>
    private void Show(SettingsViewModel? vm)
    {
        if (_vm is { } old)
        {
            old.PropertyChanged -= Changed;
            old.CloseRequested -= Closed;
            old.ConfirmRequested -= AskAsync;
            old.ProviderEditRequested -= EditProvider;
            old.WorkerEditRequested -= EditWorker;
            old.McpEditRequested -= EditMcp;
            foreach (var list in Lists(old))
                list.CollectionChanged -= ListChanged;
        }
        _vm = vm;
        if (vm is null)
            return;
        vm.PropertyChanged += Changed;
        vm.CloseRequested += Closed;
        vm.ConfirmRequested += AskAsync;
        vm.ProviderEditRequested += EditProvider;
        vm.WorkerEditRequested += EditWorker;
        vm.McpEditRequested += EditMcp;
        foreach (var list in Lists(vm))
            list.CollectionChanged += ListChanged;
    }

    private static IEnumerable<INotifyCollectionChanged> Lists(SettingsViewModel vm)
        => [vm.Providers, vm.Workers, vm.McpServers, vm.Templates, vm.ModelCatalog];

    private void Changed(object? sender, PropertyChangedEventArgs e) => _ = InvokeAsync(StateHasChanged);

    private void ListChanged(object? sender, NotifyCollectionChangedEventArgs e) => _ = InvokeAsync(StateHasChanged);

    /// <summary>Saved or cancelled: the window closes; the page opens the settings again, as they now are.</summary>
    private void Closed() => _ = InvokeAsync(async () =>
    {
        await OpenAsync();
        StateHasChanged();
    });

    /// <summary>The view model's question (removing a provider, a worker, an MCP server), as the window's dialog asks it.</summary>
    private Task<bool> AskAsync(string headline, string detail)
    {
        var answer = new TaskCompletionSource<bool>();
        _question = (headline, detail, answer);
        _ = InvokeAsync(StateHasChanged);
        return answer.Task;
    }

    private void Answer(bool yes)
    {
        if (_question is not { } question)
            return;
        _question = null;
        question.Answer.TrySetResult(yes);
    }

    /// <summary>
    /// An editor's Save writes the settings now, as the page's Save does (ServerSettings: the person, the file's version,
    /// the audit): put only into the page's copy, a server, a provider or a team member added in its window was gone at
    /// the next reload when the page's own Save, out of sight below the sections, was not pressed too. The copy is one
    /// for the page, so what else was changed on it is written with it. A refusal is said under the sections, and the
    /// copy keeps every change for another try.
    /// </summary>
    private void WriteNow() => _ = InvokeAsync(SaveAsync);

    private void EditProvider(ProviderConfig config, Action saved)
    {
        // Asked as the settings ask, so Test and Fetch use the key kept for this provider (ServerSettings).
        var editor = new ProviderEditViewModel(config, () => { saved(); WriteNow(); }, _vm!.ProviderCalls);
        editor.CloseRequested += () =>
        {
            _providerEditor = null;
            _ = InvokeAsync(StateHasChanged);
        };
        _providerEditor = editor;
        _ = InvokeAsync(StateHasChanged);
    }

    private void EditWorker(WorkerConfig config, IReadOnlyList<string> catalog, Action saved)
    {
        var editor = new WorkerEditViewModel(config, catalog, _vm!.ToolNames, () => { saved(); WriteNow(); });
        editor.CloseRequested += () =>
        {
            _workerEditor = null;
            _ = InvokeAsync(StateHasChanged);
        };
        _workerEditor = editor;
        _ = InvokeAsync(StateHasChanged);
    }

    private void EditMcp(McpServerConfig draft, Action<McpServerConfig> saved)
    {
        _mcpEditor = (draft, saved);
        _ = InvokeAsync(StateHasChanged);
    }

    private RenderFragment NavItem(SettingsSection section) => @<a class="@("settings-nav-item" + (section == _section ? " on" : ""))"
                                                                    href="@section.Href" aria-current="@(section == _section ? "page" : null)">@section.Label</a>;

    public void Dispose()
    {
        Show(null);
        // A question still open is answered no: nothing is removed by a page that went away.
        Answer(false);
    }
}
