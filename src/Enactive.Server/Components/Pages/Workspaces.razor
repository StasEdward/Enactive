@page "/workspaces"
@using Enactive.Server.Runs
@using Microsoft.AspNetCore.Components.Authorization
@inject ServerHistory History

<PageTitle>Workspaces - Enactive</PageTitle>

<h1>Workspaces</h1>
@if (Said is { Length: > 0 })
{
    <p class="said" role="alert">@Said</p>
}
<AuthorizeView Policy="Operator">
    <Authorized><p><a href="workspaces/browse">Add a folder…</a></p></Authorized>
</AuthorizeView>
@if (_workspaces.Count == 0)
{
    <p>The service has no workspace yet. An Operator adds one with “Add a folder…”, from under the service's roots.</p>
}
else
{
    <ul class="list">
        @foreach (var workspace in _workspaces)
        {
            <li>
                <a href="@Links.History(workspace.RootPath)">@workspace.Name</a>
                <a class="where" href="@Links.Library(workspace.RootPath)">templates and schedules</a>
                <span class="where">@workspace.RootPath · last used @workspace.LastOpenedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
            </li>
        }
    </ul>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> Auth { get; set; } = default!;
    [SupplyParameterFromQuery] private string? Said { get; set; }
    private IReadOnlyList<Enactive.Workspace.WorkspaceEntry> _workspaces = [];

    protected override async Task OnInitializedAsync() => _workspaces = History.Workspaces((await Auth).User);
}
