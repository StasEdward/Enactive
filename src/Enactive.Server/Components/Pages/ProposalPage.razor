@page "/proposals/view"
@using Enactive.Server.Runs
@using Microsoft.AspNetCore.Components.Authorization
@inject ServerStaging Staging

<PageTitle>Proposed changes - Enactive</PageTitle>

<p><a href="proposals">← Proposed changes</a></p>
@if (Said is { Length: > 0 })
{
    <p class="said" role="alert">@Said</p>
}
@if (_problem is not null)
{
    <p class="said">@_problem</p>
}
else if (_set is { } set)
{
    <h1>@Enactive.Application.RunLauncher.Title(set.Prompt)</h1>
    <p class="where">@set.Workspace · started by @set.Owner, @set.Started.ToString("yyyy-MM-dd HH:mm") ·
        @set.Pending of @set.Total waiting</p>
    @if (set.Running)
    {
        <p class="where">The run is still going; its proposals can be applied or rejected when it has ended.</p>
    }

    @foreach (var file in _files)
    {
        <section class="question">
            <h2>@file.Path <span class="where">@State(file)</span></h2>
            @if (file.Diff is { } diff)
            {
                <pre class="file">@diff</pre>
            }
            else
            {
                <p class="where">Not shown as text: @file.Bytes bytes.</p>
            }
            @if (!file.Applied && !file.Rejected && !set.Running)
            {
                <AuthorizeView Policy="Operator">
                    <Authorized>
                        <div class="answers">
                            <form method="post" action="/proposals/act">
                                <AntiforgeryToken />
                                <input type="hidden" name="ws" value="@Ws" />
                                <input type="hidden" name="set" value="@Set" />
                                <input type="hidden" name="change" value="@file.Id" />
                                <input type="hidden" name="act" value="apply" />
                                <button type="submit">Apply</button>
                            </form>
                            <form method="post" action="/proposals/act">
                                <AntiforgeryToken />
                                <input type="hidden" name="ws" value="@Ws" />
                                <input type="hidden" name="set" value="@Set" />
                                <input type="hidden" name="change" value="@file.Id" />
                                <input type="hidden" name="act" value="reject" />
                                <button type="submit" class="secondary">Reject</button>
                            </form>
                        </div>
                    </Authorized>
                </AuthorizeView>
            }
        </section>
    }
}

@code {
    [SupplyParameterFromQuery] private string? Ws { get; set; }
    [SupplyParameterFromQuery] private string? Set { get; set; }
    [SupplyParameterFromQuery] private string? Said { get; set; }
    [CascadingParameter] private Task<AuthenticationState> Auth { get; set; } = default!;

    private StagedSet? _set;
    private IReadOnlyList<StagedFile> _files = [];
    private string? _problem;

    protected override async Task OnInitializedAsync()
        => (_set, _files, _problem) = Staging.Open((await Auth).User, Ws ?? "", Set ?? "");

    private static string State(StagedFile f)
        => f.Applied ? "applied" : f.Rejected ? "rejected" : f.IsNew ? "new file, waiting" : "waiting";
}
