@page "/workspaces/browse"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Operator")]
@using Enactive.Server.Runs
@using Microsoft.AspNetCore.Components.Authorization
@inject ServerHistory History

<PageTitle>Add a folder - Enactive</PageTitle>

<h1>Add a folder</h1>
<p class="where">The service runs tasks only in folders under its roots (server.json, WorkspaceRoots). Links that lead
    elsewhere are not offered.</p>

@if (Path is { Length: > 0 })
{
    <p class="path">@Path</p>
}
@if (Path is { Length: > 0 } && _problem is null)
{
    <form method="post" action="/workspaces/act">
        <AntiforgeryToken />
        <input type="hidden" name="folder" value="@Path" />
        <button type="submit">Make this folder a workspace</button>
    </form>
    <p><a href="@Up">↑ up</a></p>
}

@if (_problem is not null)
{
    <p class="said">@_problem</p>
}
<ul class="list">
    @foreach (var folder in _folders)
    {
        <li><a href="@($"workspaces/browse?path={Uri.EscapeDataString(folder)}")">@(Path is { Length: > 0 } ? System.IO.Path.GetFileName(folder) : folder)</a></li>
    }
</ul>

@code {
    [SupplyParameterFromQuery] private string? Path { get; set; }
    [CascadingParameter] private Task<AuthenticationState> Auth { get; set; } = default!;

    private IReadOnlyList<string> _folders = [];
    private string? _problem;

    /// <summary>The parent, or the list of roots when the parent is not under one.</summary>
    private string Up => System.IO.Path.GetDirectoryName(Path ?? "") is { } parent
        ? $"workspaces/browse?path={Uri.EscapeDataString(parent)}"
        : "workspaces/browse";

    protected override async Task OnInitializedAsync()
        => (_folders, _problem) = History.Browse((await Auth).User, Path);
}
