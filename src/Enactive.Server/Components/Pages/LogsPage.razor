@page "/logs"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Enactive.Agents
@using Enactive.Application
@using Enactive.Core.Diagnostics
@using Enactive.Server.Runs
@using Microsoft.AspNetCore.Components.Authorization
@inject ServerLogs Logs

<PageTitle>Log - Enactive</PageTitle>

<h1>Log</h1>
<p class="where">The service's recent log - its own lines and the engine's - newest last. Narrow it down, then ask a model
    about what is shown.</p>

<div class="answers">
    <label>From
        <select @bind="_minimum">
            @foreach (var level in Enum.GetValues<LogLevel>())
            {
                <option value="@level">@level</option>
            }
        </select>
    </label>
    <label>Containing <input @bind="_search" placeholder="text, run id" /></label>
    <button class="secondary" @onclick="RefreshAsync">Show</button>
    <AuthorizeView Policy="Operator">
        <Authorized>
            <button @onclick="AnalyseAsync" disabled="@_analysing">@(_analysing ? "Asking…" : "Ask a model what went wrong")</button>
        </Authorized>
    </AuthorizeView>
</div>
<div class="answers sources">
    @foreach (var source in Enum.GetValues<LogSource>())
    {
        <label><input type="checkbox" checked="@_sources.Contains(source)" @onchange="e => Toggle(source, (bool)e.Value!)" /> @source</label>
    }
</div>

@if (_said is not null)
{
    <p class="said" role="alert">@_said</p>
}
@if (_analysis is { } analysis)
{
    <section class="question">
        <h2>@analysis.Model, on @analysis.LinesSent of @analysis.LinesTotal lines</h2>
        <div class="body">@analysis.Answer</div>
    </section>
}

<p class="where">@_entries.Count entries</p>
<pre class="file log">@foreach (var entry in _entries){@LogText.Line(entry)
}</pre>

@code {
    [CascadingParameter] private Task<AuthenticationState> Auth { get; set; } = default!;

    private LogLevel _minimum = LogLevel.Info;
    private string _search = "";
    private readonly HashSet<LogSource> _sources = Enum.GetValues<LogSource>().ToHashSet();
    private IReadOnlyList<LogEntry> _entries = [];
    private LogAnalysisResult? _analysis;
    private string? _said;
    private bool _analysing;

    protected override Task OnInitializedAsync() => RefreshAsync();

    private async Task RefreshAsync()
        => _entries = Logs.Entries((await Auth).User, _minimum, _sources, _search);

    private async Task Toggle(LogSource source, bool on)
    {
        if (on) _sources.Add(source); else _sources.Remove(source);
        await RefreshAsync();
    }

    private async Task AnalyseAsync()
    {
        _analysing = true;
        _said = null;
        _analysis = null;
        try
        {
            await RefreshAsync();
            (_analysis, _said) = await Logs.AnalyseAsync((await Auth).User, _entries, CancellationToken.None);
        }
        catch (Exception ex)
        {
            _said = "The model could not be asked: " + ex.Message;
        }
        finally
        {
            _analysing = false;
        }
    }
}
