@page "/admin/audit"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Admin")]
@using Enactive.Server.Accounts
@using Microsoft.AspNetCore.Components.Authorization
@inject AccountAdmin Accounts

<PageTitle>Audit - Enactive</PageTitle>

<h1>Audit</h1>
<p class="where">Who did what on this service, newest first: sign-ins, runs started and cancelled, questions answered,
    history and account changes.</p>

<table class="timeline">
    @foreach (var entry in _trail)
    {
        <tr>
            <td class="when">@entry.At.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
            <td class="kind">@entry.Account</td>
            <td>@entry.Action</td>
            <td>@entry.Detail</td>
            <td class="when">@entry.Remote</td>
        </tr>
    }
</table>

@code {
    [CascadingParameter] private Task<AuthenticationState> Auth { get; set; } = default!;

    private IReadOnlyList<(DateTimeOffset At, string Account, string Action, string? Detail, string? Remote)> _trail = [];

    protected override async Task OnInitializedAsync() => _trail = Accounts.Trail((await Auth).User);
}
