@page "/library/template"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Operator")]
@using Enactive.Server.Runs
@using Microsoft.AspNetCore.Components.Authorization
@inject ServerLibrary Library

<PageTitle>Template - Enactive</PageTitle>

<p><a href="@Links.Library(Ws ?? "")">← templates and schedules</a></p>
<h1>@(string.IsNullOrEmpty(Id) ? "New template" : Id)</h1>
@* The template as its file holds it (TemplateStore's own format): what is shown is what is stored, and every field a
   template has is reachable - parameters, checks, limits, the permissions it may never exceed. Checked by the same
   validator as the window's editor before it is written. *@
@if (_problem is not null)
{
    <p class="said">@_problem</p>
}
else
{
    <form method="post" action="/library/template/act" class="start wide">
        <AntiforgeryToken />
        <input type="hidden" name="ws" value="@Ws" />
        <input type="hidden" name="act" value="save" />
        <label>The template, as JSON <textarea name="json" rows="28" spellcheck="false">@_json</textarea></label>
        <label>Kept in
            <select name="scope">
                <option value="Workspace">this workspace's library - with the project, next to its code</option>
                <option value="Global">the service's global library - for every workspace</option>
            </select>
        </label>
        <button type="submit">Save</button>
    </form>
}

@code {
    [SupplyParameterFromQuery] private string? Ws { get; set; }
    [SupplyParameterFromQuery] private string? Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState> Auth { get; set; } = default!;

    private string? _json;
    private string? _problem;

    protected override async Task OnInitializedAsync()
        => (_json, _problem) = Library.TemplateText((await Auth).User, Ws ?? "", Id);
}
