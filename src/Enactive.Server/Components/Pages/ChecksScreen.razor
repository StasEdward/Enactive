@page "/checks"
@using System.Security.Claims
@using Enactive.Application
@using Enactive.Server.Components.Runs
@using Enactive.Server.Components.Ui
@using Enactive.Server.Runs
@using Microsoft.AspNetCore.Components.Authorization
@inject ServerChecks Checks
@inject ServerLessons Lessons
@implements IDisposable
@inject ServerHistory History
@inject WorkspaceIds Ids
@inject ChosenWorkspace Chosen

<PageTitle>Checks - Enactive</PageTitle>

@* A workspace's checks (Plan Phase 3.5), as the window opens them from its workspace card (ChecksWindow): the list every run
   here is judged by - this workspace's own manifests in its .enactive/checks, the service's global ones, the engine's
   implicit build and test - for anybody signed in to read, and for an Operator to change (ServerChecks, as the person,
   audited). Not while a run works in the workspace: it puts its checks back at its end. The workspace is chosen in the
   switcher, as on the Templates screen. *@

<div class="checks-screen">
    <div class="templates-top">
        <PanelHeader Text="WORKSPACE" />
        <WorkspaceSwitcher Rows="_switcher" Current="_switcher.FirstOrDefault(r => r.IsCurrent)" Href="@(row => Links.Checks(row.Id))" />
    </div>

    @if (_problem is { } problem)
    {
        <p class="said">@problem</p>
    }
    else if (_list is { } list)
    {
        <CascadingValue Value="list"><ChecksEditor /></CascadingValue>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> Auth { get; set; } = default!;

    /// <summary>The workspace, by its id (WorkspaceIds); none, the one used last. Read as text, as the Templates screen does.</summary>
    [SupplyParameterFromQuery(Name = "ws")] private string? Ws { get; set; }

    /// <summary>A lesson to make into a check (Plan Phase 5.4), from the Lessons screen: the form opens filled in from it.</summary>
    [SupplyParameterFromQuery(Name = "lesson")] private string? Lesson { get; set; }

    private Enactive.Core.Rules.RuleEntry? _lesson;
    private string? _root;
    private System.Security.Claims.ClaimsPrincipal? _user;

    private IReadOnlyList<SwitcherRow> _switcher = [];
    private ChecksViewModel? _list;
    private string? _problem;

    // Read per address (Pages/_Imports.razor): choosing another workspace is a link to this same page.
    protected override async Task OnParametersSetAsync()
    {
        var user = (await Auth).User;
        var known = History.Workspaces(user);
        Guid? wanted = Chosen.Wanted(Ws is { Length: > 0 } ? Guid.TryParse(Ws, out var id) ? id : Guid.Empty : null, known, Ids, user);
        var selected = WorkspaceColumnState.Choose(known, wanted, Ids);
        Chosen.Shown(selected, Ids, user);
        _switcher = WorkspaceColumnState.Switcher(known, selected, Ids);
        if (selected is null)
        {
            (_list, _problem) = (null, wanted is null
                ? "The service knows no workspace yet. An Operator adds one on the Runs screen."
                : "The service does not know that workspace.");
            return;
        }
        Follow(null);
        (_list, _problem) = Checks.Workspace(user, selected.RootPath);
        (_root, _user, _lesson) = (selected.RootPath, user, null);
        // The form from a lesson, for a person the list lets change checks: the command left for them to write.
        if (_list is { CanChange: true } list && Guid.TryParse(Lesson, out var lessonId)
            && await Lessons.CandidateAsync(user, selected.RootPath, lessonId, CancellationToken.None) is { } lesson)
        {
            _lesson = lesson;
            list.AddFrom(LessonsViewModel.CheckIdFor(lesson.Text), lesson.Text);
            Follow(list);
        }
    }

    // Saved from the lesson's form: the lesson is set aside, once, as the window does after its Checks window closes.
    private void Follow(ChecksViewModel? list)
    {
        if (_list is { } old) old.PropertyChanged -= Saved;
        if (list is not null) list.PropertyChanged += Saved;
    }

    private void Saved(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        if (e.PropertyName != nameof(ChecksViewModel.LastSaved) || _lesson is not { } lesson || _list?.LastSaved is not { } id
            || _root is null || _user is null)
            return;
        _lesson = null;
        _ = Lessons.MadeIntoCheckAsync(_user, _root, lesson, id, CancellationToken.None);
    }

    public void Dispose() => Follow(null);
}
