@page "/library"
@using Enactive.Core.Templates
@using Enactive.Workspace
@using Enactive.Server.Runs
@using Microsoft.AspNetCore.Components.Authorization
@inject ServerLibrary Library
@inject ServerHistory History

<PageTitle>Templates and schedules - Enactive</PageTitle>

<p><a href="@Links.History(Ws ?? "")">← @Ws</a></p>
<h1>Templates and schedules</h1>
@if (Said is { Length: > 0 })
{
    <p class="said" role="alert">@Said</p>
}
@if (_problem is not null)
{
    <p class="said">@_problem</p>
}
else
{
    <h2>Schedules</h2>
    <AuthorizeView Policy="Operator"><Authorized><p><a href="@Links.Schedule(Ws!, null)">New schedule…</a></p></Authorized></AuthorizeView>
    @if (_schedules.Count == 0)
    {
        <p>No schedules in this workspace.</p>
    }
    <ul class="list">
        @foreach (var view in _schedules)
        {
            <li>
                <strong>@view.Schedule.Name</strong> <span class="where">@view.When · @view.Next</span>
                <ul class="entries">
                    @foreach (var line in view.MayDo)
                    {
                        <li>@line</li>
                    }
                </ul>
                @foreach (var outcome in view.Outcomes)
                {
                    <div class="where">@outcome.At.ToLocalTime().ToString("yyyy-MM-dd HH:mm") · @outcome.Summary</div>
                }
                <AuthorizeView Policy="Operator">
                    <Authorized>
                        <div class="answers">
                            <a href="@Links.Schedule(Ws!, view.Schedule.Id)">Edit</a>
                            <form method="post" action="/library/schedule/act" class="inline">
                                <AntiforgeryToken />
                                <input type="hidden" name="ws" value="@Ws" />
                                <input type="hidden" name="id" value="@view.Schedule.Id" />
                                <input type="hidden" name="act" value="@(view.Schedule.Enabled ? "off" : "on")" />
                                <button type="submit" class="secondary">@(view.Schedule.Enabled ? "Switch off" : "Switch on")</button>
                            </form>
                            <form method="post" action="/library/schedule/act" class="inline">
                                <AntiforgeryToken />
                                <input type="hidden" name="ws" value="@Ws" />
                                <input type="hidden" name="id" value="@view.Schedule.Id" />
                                <input type="hidden" name="act" value="delete" />
                                <button type="submit" class="secondary">Delete</button>
                            </form>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </li>
        }
    </ul>

    <h2>Templates</h2>
    <AuthorizeView Policy="Operator"><Authorized><p><a href="@Links.Template(Ws!, null)">New template…</a></p></Authorized></AuthorizeView>
    <ul class="list">
        @foreach (var stored in _templates)
        {
            <li>
                <strong>@stored.Template.Name</strong> <span class="where">@stored.Template.Id · @stored.Origin@(stored.Shadows is { } under ? $" (over the {under} one)" : "")</span>
                @if (stored.Template.Description is { Length: > 0 } description)
                {
                    <div class="where">@description</div>
                }
                <AuthorizeView Policy="Operator">
                    <Authorized>
                        <div class="answers">
                            <a href="@Links.Template(Ws!, stored.Template.Id)">@(stored.IsBuiltin ? "Copy and edit" : "Edit")</a>
                            @if (stored.Scope is { } scope)
                            {
                                <form method="post" action="/library/template/act" class="inline">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="ws" value="@Ws" />
                                    <input type="hidden" name="id" value="@stored.Template.Id" />
                                    <input type="hidden" name="scope" value="@scope" />
                                    <input type="hidden" name="act" value="delete" />
                                    <button type="submit" class="secondary">Delete</button>
                                </form>
                            }
                        </div>
                    </Authorized>
                </AuthorizeView>
            </li>
        }
    </ul>
}

@code {
    [SupplyParameterFromQuery] private string? Ws { get; set; }
    [SupplyParameterFromQuery] private string? Said { get; set; }
    [CascadingParameter] private Task<AuthenticationState> Auth { get; set; } = default!;

    private IReadOnlyList<StoredTemplate> _templates = [];
    private IReadOnlyList<ScheduleView> _schedules = [];
    private string? _problem;

    protected override async Task OnInitializedAsync()
    {
        var user = (await Auth).User;
        (_templates, _problem) = Library.Templates(user, Ws ?? "");
        if (_problem is null)
            (_schedules, _problem) = await Library.SchedulesAsync(user, Ws ?? "", CancellationToken.None);
    }
}
