@page "/runs/{Id:guid}"
@* Live, and not drawn ahead of its connection: a prerendered page shows answer and cancel buttons that do nothing
   until the connection is up, and a click there was lost (found by tests/server-e2e). *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@using Enactive.Core.History
@using Enactive.Server.Runs
@using Microsoft.AspNetCore.Components.Authorization
@inject IRunControl Runs

<PageTitle>@(_run is null ? "Run" : RunState.Title(_run)) - Enactive</PageTitle>

@if (_run is null)
{
    <p>There is no such run on the service. Runs started before it last restarted are in the history.</p>
}
else
{
    <h1>@RunState.Title(_run)</h1>
    <p class="where">@_run.Workspace · started by @_run.Owner at @_run.StartedAt.ToString("HH:mm")</p>
    <p class="state">@RunState.Of(_run)</p>
    @if (_view.Action.Length > 0)
    {
        <p class="now">@_view.Action</p>
    }

    @if (_run.Questions.Pending is { } question)
    {
        <section class="question" role="alert">
            <h2>@question.Request.Topic</h2>
            @* The full action, not the summary: this is what the answer authorises. *@
            <pre>@question.Request.FullText</pre>
            <div class="answers">
                @foreach (var choice in question.Choices)
                {
                    <button @onclick="() => AnswerAsync(question.Request.Id, choice.Label)">@choice.Label</button>
                }
            </div>
        </section>
    }

    <AuthorizeView Policy="Operator">
        @if (!_run.Ended.IsCompleted)
        {
            <button class="cancel" @onclick="CancelAsync">Cancel the run</button>
        }
    </AuthorizeView>

    @if (_said is not null)
    {
        <p class="said" role="alert">@_said</p>
    }

    <ol class="cards">
        @foreach (var card in _view.Cards)
        {
            <li class="card @card.Status.ToString().ToLowerInvariant()">
                <div class="card-head"><span class="card-title">@card.Title</span> <span class="card-status">@card.Status</span></div>
                <div class="card-activity">@card.Activity</div>
                @if (card.Tally.Length > 0)
                {
                    <div class="card-tally">@card.Tally</div>
                }
            </li>
        }
    </ol>
}

@code {
    [Parameter] public Guid Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState> Auth { get; set; } = default!;

    private ServerRun? _run;
    private RunFollower? _follower;
    private View _view = View.Empty;
    private string? _said;

    /// <summary>What the page shows of the run, copied out of its fold under the session's lock.</summary>
    private sealed record CardView(string Title, FeedCardStatus Status, string Activity, string Tally);
    private sealed record View(IReadOnlyList<CardView> Cards, string Action, long Seq)
    {
        public static readonly View Empty = new([], "", 0);
    }

    protected override async Task OnInitializedAsync()
    {
        _run = Runs.Find((await Auth).User, Id);
        if (_run is null)
            return;

        _run.Changed += OnRunChanged;
        // Reads where the run stands, follows it from there, and redraws as it goes (RunFollower).
        _follower = new RunFollower(_run.Session, () => (_view = Read()).Seq, () => InvokeAsync(StateHasChanged));
        _follower.Start();
    }

    private View Read()
        => _run!.Session.Read((feed, activity, seq) => new View(
            feed.Cards.Select(c => new CardView(c.Title, c.Status, c.Activity, c.Tally)).ToList(),
            activity.CurrentAction, seq));

    private void OnRunChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task AnswerAsync(Guid question, string choice)
        => _said = Runs.Answer((await Auth).User, Id, question, choice);

    private async Task CancelAsync()
        => _said = Runs.Cancel((await Auth).User, Id);

    public ValueTask DisposeAsync()
    {
        if (_run is not null)
            _run.Changed -= OnRunChanged;
        _follower?.Dispose();
        return ValueTask.CompletedTask;
    }
}
