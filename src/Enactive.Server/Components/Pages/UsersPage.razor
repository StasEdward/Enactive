@page "/admin/users"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Admin")]
@using Enactive.Server.Accounts
@using Microsoft.AspNetCore.Components.Authorization
@inject AccountAdmin Accounts

<PageTitle>Accounts - Enactive</PageTitle>

<h1>Accounts</h1>
@if (Said is { Length: > 0 })
{
    <p class="said" role="alert">@Said</p>
}

@* ADR 0002, trust model: said where a role is given, because it is where somebody would assume otherwise. *@
<p class="warning">
    The people signed in to this service trust each other. A run started here runs as the service's own account, with
    its shell when the folder allows it - so an Operator can, through a run, read what that account can read, the
    other people's settings and secrets included. Roles decide what each may do on these pages, not what they could
    reach through a run. Give Operator and Admin to people you would give a login to this machine.
</p>

<table class="timeline">
    <tr><th>Name</th><th>Role</th><th>State</th><th></th></tr>
    @foreach (var account in _accounts)
    {
        <tr>
            <td>@account.Name</td>
            <td>
                <form method="post" action="/admin/users/act" class="inline">
                    <AntiforgeryToken />
                    <input type="hidden" name="act" value="@AccountAdmin.Act.Role" />
                    <input type="hidden" name="name" value="@account.Name" />
                    <select name="role" aria-label="Role of @account.Name">
                        @foreach (var role in Enum.GetValues<Role>())
                        {
                            <option value="@role" selected="@(role == account.Role)">@role</option>
                        }
                    </select>
                    <button type="submit" class="secondary">Set</button>
                </form>
            </td>
            <td>@(account.Disabled ? "disabled" : account.LockedUntil is { } until && until > DateTimeOffset.UtcNow ? $"locked until {until.ToLocalTime():HH:mm}" : "active")</td>
            <td>
                <form method="post" action="/admin/users/act" class="inline">
                    <AntiforgeryToken />
                    <input type="hidden" name="act" value="@(account.Disabled ? AccountAdmin.Act.Enable : AccountAdmin.Act.Disable)" />
                    <input type="hidden" name="name" value="@account.Name" />
                    <button type="submit" class="secondary">@(account.Disabled ? "Enable" : "Disable")</button>
                </form>
                <form method="post" action="/admin/users/act" class="inline">
                    <AntiforgeryToken />
                    <input type="hidden" name="act" value="@AccountAdmin.Act.Password" />
                    <input type="hidden" name="name" value="@account.Name" />
                    <input type="password" name="password" placeholder="new password" autocomplete="new-password" aria-label="New password for @account.Name" />
                    <input type="password" name="again" placeholder="again" autocomplete="new-password" aria-label="New password again" />
                    <button type="submit" class="secondary">Set password</button>
                </form>
            </td>
        </tr>
    }
</table>

<h2>Add an account</h2>
<form method="post" action="/admin/users/act" class="start">
    <AntiforgeryToken />
    <input type="hidden" name="act" value="@AccountAdmin.Act.Add" />
    <label>Name <input name="name" autocomplete="off" /></label>
    <label>Role
        <select name="role">
            <option value="Viewer">Viewer - reads runs and logs</option>
            <option value="Operator" selected>Operator - runs tasks, answers their questions</option>
            <option value="Admin">Admin - also settings and accounts</option>
        </select>
    </label>
    <label>Password (12 characters or more) <input type="password" name="password" autocomplete="new-password" /></label>
    <label>Again <input type="password" name="again" autocomplete="new-password" /></label>
    <button type="submit">Add</button>
</form>

@code {
    [CascadingParameter] private Task<AuthenticationState> Auth { get; set; } = default!;
    [SupplyParameterFromQuery] private string? Said { get; set; }

    private IReadOnlyList<Account> _accounts = [];

    protected override async Task OnInitializedAsync() => _accounts = Accounts.List((await Auth).User);
}
