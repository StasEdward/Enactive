@using System.ComponentModel
@using Enactive.Core.Guidance
@implements IDisposable

@* The window's team member editor (WorkerEditWindow.axaml), in a dialog over the settings: id, role, instructions, the
   tools the engine registers as ticks (WorkerTools, whose hint says what the ticks permit), the level, the model and
   its fallback with "(none)" first. Apply puts the change into the settings' copy; it is written when they are saved. *@

@* Half as wide again as a dialog, in two columns - who the member is and what it is told on the left, what it may use
   and run on on the right: in one narrow column the tools wrapped into five rows and the dialog ran past the screen. *@
<Dialog Title="Team member" Class="dialog-team" OnClose="() => Editor.CancelCommand.Execute(null)">
    <ChildContent>
        <div class="settings-editor-columns">
        <div class="settings-editor-column">
            <label class="label" for="worker-id">Id</label>
            <input id="worker-id" placeholder="id — unique, e.g. developer, architect" @bind="Editor.Id" />

            <label class="label" for="worker-role">Role</label>
            <input id="worker-role" placeholder="role name shown in the picker" @bind="Editor.Role" />

            <label class="label" for="worker-instructions">Instructions</label>
            <textarea id="worker-instructions" rows="14" placeholder="base instructions (honesty rules + global instructions are added automatically)"
                      @bind="Editor.Instructions"></textarea>
        </div>

        <div class="settings-editor-column">
            <span class="settings-label-row"><span class="label" id="worker-tools">Tools</span><HintMark Text="@Editor.ToolsHint" Of="Tools" /></span>
            <div class="settings-tools" role="group" aria-labelledby="worker-tools">
                @foreach (var tool in Editor.Tools)
                {
                    <label class="check"><input type="checkbox" @bind="tool.IsSelected" /> @tool.Name</label>
                }
            </div>

            <label class="label" for="worker-level">Permission level</label>
            <select id="worker-level" @bind="Editor.Level">
                @foreach (var level in Editor.Levels)
                {
                    <option value="@level">@level</option>
                }
            </select>

            <span class="settings-label-row"><label class="label" for="worker-model">Model</label><HintMark Text="@RoleAdvice.Model" Of="Model" /></span>
            <select id="worker-model" @bind="Editor.Model">
                @foreach (var model in Editor.Models)
                {
                    <option value="@model">@model</option>
                }
            </select>

            <span class="settings-label-row"><label class="label" for="worker-fallback">Fallback model</label><HintMark Text="@RoleAdvice.Fallback" Of="Fallback model" /></span>
            <select id="worker-fallback" @bind="Editor.Fallback">
                @foreach (var model in Editor.Fallbacks)
                {
                    <option value="@model">@model</option>
                }
            </select>
        </div>
        </div>

        <p class="hint">Apply puts this back in Settings. It is written to disk when you press Save there - Cancel there discards it.</p>
    </ChildContent>
    <Actions>
        <button type="button" class="btn primary" @onclick="() => Editor.SaveCommand.Execute(null)">Apply</button>
        <button type="button" class="btn" @onclick="() => Editor.CancelCommand.Execute(null)">Cancel</button>
    </Actions>
</Dialog>

@code {
    // Cascading, not a parameter: the editor is internal to the application layer (as SettingsViewModel is).
    [CascadingParameter] private WorkerEditViewModel Editor { get; set; } = default!;

    private WorkerEditViewModel? _watched;

    // The tools' hint follows each tick (WorkerEditViewModel.ToolsHint).
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_watched, Editor))
            return;
        if (_watched is not null)
            _watched.PropertyChanged -= Changed;
        _watched = Editor;
        _watched.PropertyChanged += Changed;
    }

    private void Changed(object? sender, PropertyChangedEventArgs e) => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (_watched is not null)
            _watched.PropertyChanged -= Changed;
    }
}
