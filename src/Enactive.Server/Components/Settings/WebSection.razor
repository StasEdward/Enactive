@using Enactive.Application

@* The window's Web pane (SettingsWindow.axaml): whether tasks may read the web, where search goes, whether either asks. *@

<h2 class="label">Web</h2>
<p class="hint">Whether tasks may read the web. fetch_url reads a page by its address and returns its text; web_search searches through a search server you run. What they bring back is treated as data from the web, not as instructions.</p>

<span class="settings-label-row">
    <label class="check"><input type="checkbox" @bind="Vm.WebEnabled" /> Let tasks read the web</label>
    <HintMark Of="Let tasks read the web" Text="Public addresses only: not this computer and not its network. Asking for a page sends its address out of this computer - the address can carry anything the model puts in it." />
</span>

@* The address is kept in the clear and shown on this page, and there is no field for a credential beside it. *@
<span class="settings-label-row">
    <label class="label" for="web-search">Search server</label>
    <HintMark Class="settings-credentials" Of="Search server" Text="A SearXNG server, for example one started in Docker. In its settings.yml, add json under search.formats - that is what web_search reads. Leave empty for no web_search. A search query is written from the task and leaves this computer. No key or password in the address - it is kept in the clear and shown here. A search server that needs one is not one web_search can use." />
</span>
<input id="web-search" placeholder="http://localhost:8888" disabled="@(!Vm.WebEnabled)" @bind="Vm.WebSearchUrl" @bind:event="oninput" />
@if (Vm.HasWebProblem)
{
    <p class="hint settings-problem" role="alert">@Vm.WebProblem</p>
}

<span class="settings-label-row">
    <label class="check"><input type="checkbox" disabled="@(!Vm.WebEnabled)" @bind="Vm.WebUseWithoutAsking" /> Use without asking each time</label>
    <HintMark Of="Use without asking each time" Text="@Vm.WebAsking" />
</span>

<p class="hint settings-state">@Vm.WebState</p>

@code {
    // Handed down as a cascading value rather than a parameter: the view model is internal to the application layer,
    // and a component's parameters are public.
    [CascadingParameter] private SettingsViewModel Vm { get; set; } = default!;
}
