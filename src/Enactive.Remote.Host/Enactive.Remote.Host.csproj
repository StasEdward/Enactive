<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!--
      Contracts and the two things delivery needs: a SignalR client to reach the gateway, and
      SQLite for the queues that have to survive a crash.

      Core arrives in stage 4, and its arrival is the stage: until this reference existed, this
      library could accept a command, remember it and report about it, and could not run anything.
      That is why delivery was built and proven first - none of it depends on the engine, and it is
      the part that has to be right when the network is not.
    -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />

    <!--
      Pinned explicitly, above what Microsoft.Data.Sqlite asks for. The version it brings by
      default was SQLitePCLRaw.lib.e_sqlite3 2.1.11, which NU1903 reports as a known high-severity
      vulnerability (GHSA-2m69-gcr7-jv3q) - a warning the build printed and nothing would have
      failed on. This is the native SQLite library the local queue runs on, so it is not a
      transitive dependency anyone should inherit by accident.
    -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <ProjectReference Include="..\Enactive.Remote.Contracts\Enactive.Remote.Contracts.csproj" />
    <ProjectReference Include="..\Enactive.Core\Enactive.Core.csproj" />

    <!--
      The computer's remote keys are kept the way the API key is: DPAPI, this Windows user. One
      implementation of "protected at rest", so a fix to it reaches both.
    -->
    <ProjectReference Include="..\Enactive.Secrets\Enactive.Secrets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      For test seams that must not be public API: KeyAdministration's hook that shows a test the secret
      arrays it reads, so the test can check they were wiped. Public, any caller could watch the pairing
      secret go by.
    -->
    <InternalsVisibleTo Include="Enactive.Engine.Tests" />

    <!--
      SecretProtector.ForTestsOnly, which writes the computer's keys down in the clear: for the end-to-end
      tests and the browser-test harness, which run a computer on Linux, where there is no DPAPI. Internal so
      the desktop cannot be built to use it.
    -->
    <InternalsVisibleTo Include="Enactive.Remote.Gateway.Tests" />
    <InternalsVisibleTo Include="RemoteHostHarness" />
  </ItemGroup>

</Project>
