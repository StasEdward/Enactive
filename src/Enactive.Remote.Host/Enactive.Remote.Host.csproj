<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!--
      Contracts and the two things delivery needs: a SignalR client to reach the gateway, and
      SQLite for the queues that have to survive a crash.

      There is NO reference to Enactive.Core here, and that is the shape of stage 3 in
      Docs/REMOTE_DESIGN.md rather than an oversight: at this stage the Host can accept a command,
      remember it and report about it, and it CANNOT run anything, because the engine is not on the
      other end of a reference it does not have. The binding is stage 4, and adding this reference
      is what that stage begins with.
    -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />

    <!--
      Pinned explicitly, above what Microsoft.Data.Sqlite asks for. The version it brings by
      default was SQLitePCLRaw.lib.e_sqlite3 2.1.11, which NU1903 reports as a known high-severity
      vulnerability (GHSA-2m69-gcr7-jv3q) - a warning the build printed and nothing would have
      failed on. This is the native SQLite library the local queue runs on, so it is not a
      transitive dependency anyone should inherit by accident.
    -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <ProjectReference Include="..\Enactive.Remote.Contracts\Enactive.Remote.Contracts.csproj" />
  </ItemGroup>

</Project>
