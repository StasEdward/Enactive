<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\AIClient.Core\AIClient.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lightweight ADO.NET SQLite provider (no EF). Bump to 10.x to match .NET 10 if you prefer. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <!-- Override the transitive 2.1.10 (NU1903 advisory GHSA-2m69-gcr7-jv3q) with a patched native bundle. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.11" />
    <!-- Modern async MySQL driver. Only used when AICLIENT_STORE=mysql. -->
    <PackageReference Include="MySqlConnector" Version="2.3.7" />
  </ItemGroup>
</Project>
