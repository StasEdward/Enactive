# Cloudflare Pages response headers. Rules are matched top-down; the first
# matching block wins per header, so the specific asset rules come after /*.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  # No 'unsafe-inline' anywhere: the hero script lives in assets/hero.js and the page
  # carries no inline style attributes, so both directives can stay 'self'. Google Fonts
  # is the only third party the page talks to.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable
