<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Enactive.Core\Enactive.Core.csproj" />
    <ProjectReference Include="..\Enactive.Mcp.TestServer\Enactive.Mcp.TestServer.csproj" />
    <ProjectReference Include="..\..\src\Enactive.Agents\Enactive.Agents.csproj" />
    <ProjectReference Include="..\..\src\Enactive.Tools\Enactive.Tools.csproj" />
    <ProjectReference Include="..\..\src\Enactive.Workspace\Enactive.Workspace.csproj" />
    <ProjectReference Include="..\..\src\Enactive.Providers\Enactive.Providers.csproj" />
    <ProjectReference Include="..\..\src\Enactive.Secrets\Enactive.Secrets.csproj" />
    <ProjectReference Include="..\..\src\Enactive.Settings\Enactive.Settings.csproj" />
    <ProjectReference Include="..\..\src\Enactive.Remote.Contracts\Enactive.Remote.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Enactive.Remote.Host\Enactive.Remote.Host.csproj" />
  </ItemGroup>

  <!--
    The MCP tests start the test server with `dotnet <dll>`, against the copy of it that the project
    reference puts in THIS project's output. That launch needs the server's runtimeconfig.json beside
    that copy, and a ProjectReference brings the assembly but not that file.

    The path is taken from what the reference actually produced, never assembled by hand from
    $(Configuration). Hand-assembling it was wrong in a way that only showed up on a clean machine:
    the server was not in the solution, so a Release build of the solution
    still built it into bin/Debug while this target looked in bin/Release, and the whole solution
    failed with MSB3030 on every push, since build.yml builds the solution in Release. Old artifacts in a
    working folder hid it. The server is in the solution now, and this no longer depends on that.
  -->
  <Target Name="CopyMcpTestRuntime" AfterTargets="Build">
    <ItemGroup>
      <McpTestServerRuntimeConfig
        Include="@(_ResolvedProjectReferencePaths->'%(RootDir)%(Directory)%(Filename).runtimeconfig.json')"
        Condition="'%(Filename)' == 'Enactive.Mcp.TestServer'" />
    </ItemGroup>
    <Copy SourceFiles="@(McpTestServerRuntimeConfig)" DestinationFolder="$(OutDir)" />
  </Target>

</Project>
