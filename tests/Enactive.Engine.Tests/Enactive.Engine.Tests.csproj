<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Enactive.Core\Enactive.Core.csproj" />
    <ProjectReference Include="..\Enactive.Mcp.TestServer\Enactive.Mcp.TestServer.csproj" />
    <ProjectReference Include="..\..\src\Enactive.Agents\Enactive.Agents.csproj" />
    <ProjectReference Include="..\..\src\Enactive.Tools\Enactive.Tools.csproj" />
    <ProjectReference Include="..\..\src\Enactive.Workspace\Enactive.Workspace.csproj" />
    <ProjectReference Include="..\..\src\Enactive.Providers\Enactive.Providers.csproj" />
  </ItemGroup>

  <Target Name="CopyMcpTestRuntime" AfterTargets="Build">
    <Copy SourceFiles="../Enactive.Mcp.TestServer/bin/$(Configuration)/$(TargetFramework)/Enactive.Mcp.TestServer.runtimeconfig.json"
          DestinationFolder="$(OutDir)" />
  </Target>

</Project>
