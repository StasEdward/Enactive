<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="TestRepositoryRoot" Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..'))" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MailKit" Version="4.18.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../src/Enactive.App.Ui/ViewModels/ModelPerformance.cs" Link="Ui/ModelPerformance.cs" />
    <Compile Include="../../src/Enactive.App.Ui/RunEventPump.cs" Link="Ui/RunEventPump.cs" />
    <Compile Include="../../src/Enactive.App.Ui/RemoteAccessService.cs" Link="Ui/RemoteAccessService.cs" />
    <Compile Include="../../src/Enactive.App.Ui/ForegroundRunSlot.cs" Link="Ui/ForegroundRunSlot.cs" />
    <Compile Include="../../src/Enactive.App.Ui/BackgroundRunGroup.cs" Link="Ui/BackgroundRunGroup.cs" />
    <Compile Include="../../src/Enactive.App.Ui/DecisionCompletion.cs" Link="Ui/DecisionCompletion.cs" />
    <Compile Include="../../src/Enactive.App.Ui/BatchObservableCollection.cs" Link="Ui/BatchObservableCollection.cs" />
    <Compile Include="../../src/Enactive.App.Ui/LogFilter.cs" Link="Ui/LogFilter.cs" />
    <Compile Include="../../src/Enactive.App.Ui/InboxDecisions.cs" Link="Ui/InboxDecisions.cs" />
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    The shared crypto vectors live beside the sources (tests/vectors) because the panel's JS tests read
    the same file. The test reads its copy from the output directory, so it does not depend on where the
    checkout is; Link puts it at the output root.
  -->
  <ItemGroup>
    <None Include="..\vectors\remote-crypto-v2.json" Link="remote-crypto-v2.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Enactive.Core\Enactive.Core.csproj" />
    <ProjectReference Include="..\Enactive.Mcp.TestServer\Enactive.Mcp.TestServer.csproj" />
    <ProjectReference Include="..\..\src\Enactive.Agents\Enactive.Agents.csproj" />
    <ProjectReference Include="..\..\tools\Enactive.Bench\Enactive.Bench.csproj" />
    <ProjectReference Include="..\..\src\Enactive.Tools\Enactive.Tools.csproj" />
    <ProjectReference Include="..\..\src\Enactive.Workspace\Enactive.Workspace.csproj" />
    <ProjectReference Include="..\..\src\Enactive.Providers\Enactive.Providers.csproj" />
    <ProjectReference Include="..\..\src\Enactive.Secrets\Enactive.Secrets.csproj" />
    <ProjectReference Include="..\..\src\Enactive.Settings\Enactive.Settings.csproj" />
    <ProjectReference Include="..\..\src\Enactive.Remote.Contracts\Enactive.Remote.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Enactive.Remote.Host\Enactive.Remote.Host.csproj" />
  </ItemGroup>

  <!--
    The MCP tests start the test server with `dotnet <dll>`, against the copy of it that the project
    reference puts in THIS project's output. That launch needs the server's runtimeconfig.json beside
    that copy, and a ProjectReference brings the assembly but not that file.

    The path is taken from what the reference actually produced, never assembled by hand from
    $(Configuration). Hand-assembling it was wrong in a way that only showed up on a clean machine:
    the server was not in the solution, so a Release build of the solution
    still built it into bin/Debug while this target looked in bin/Release, and the whole solution
    failed with MSB3030 on every push, since build.yml builds the solution in Release. Old artifacts in a
    working folder hid it. The server is in the solution now, and this no longer depends on that.
  -->
  <Target Name="CopyMcpTestRuntime" AfterTargets="Build">
    <ItemGroup>
      <McpTestServerRuntimeConfig Include="@(_ResolvedProjectReferencePaths->'%(RootDir)%(Directory)%(Filename).runtimeconfig.json')" Condition="'%(Filename)' == 'Enactive.Mcp.TestServer'" />
    </ItemGroup>
    <Copy SourceFiles="@(McpTestServerRuntimeConfig)" DestinationFolder="$(OutDir)" />
  </Target>

</Project>
