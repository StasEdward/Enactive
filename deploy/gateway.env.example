# The gateway's environment: /etc/enactive-remote/gateway.env, owned by enactive, mode 0600.
#
# first-install.sh starts from this file and fills in ENACTIVE_REMOTE_DB itself; everything else is yours
# to fill in. It is read by systemd (EnvironmentFile=), not by a shell: one NAME=value per line, nothing
# quoted, and a value runs to the end of its line - which is why a connection string full of ';' and
# spaces needs no quoting here, and why this file cannot be sourced with `.` either.
#
# The secrets below live here and nowhere else - not in the unit, which is world-readable, and never in
# the repository. ENACTIVE_DATA, ENACTIVE_BEHIND_TUNNEL and ASPNETCORE_URLS are not secret and are set
# in enactive-remote.service.

# ── the database ────────────────────────────────────────────────────────────

# Protocol 2's own database. The protocol-1 database (enactive_remote) is left untouched beside it: it
# is the rollback, and the two schemas share nothing. first-install.sh writes the password.
ENACTIVE_REMOTE_DB=Server=127.0.0.1;User ID=enactive_gateway;Password=set-by-first-install;Database=enactive_remote_v2;

# ── signing in ──────────────────────────────────────────────────────────────

# The address people use, scheme and host and nothing more. The providers send people back here, so
# it must be what the browser shows, not 127.0.0.1.
ENACTIVE_PUBLIC_ORIGIN=https://remote.enactive.dev

# One pair per provider, from the provider's OAuth app registered for the origin above. Both of a pair
# or neither: half a pair stops the gateway, rather than offering a sign-in that fails for everyone.
#   GitHub:  callback URL   https://<origin>/auth/github/callback
#   Google:  redirect URI   https://<origin>/auth/google/callback
ENACTIVE_GITHUB_CLIENT_ID=
ENACTIVE_GITHUB_CLIENT_SECRET=
ENACTIVE_GOOGLE_CLIENT_ID=
ENACTIVE_GOOGLE_CLIENT_SECRET=

# Who may create an account. "list": only identities approved with `admin approve` (see
# Docs/REMOTE_OPERATIONS.md). "open": anyone who signs in - not before the privacy and terms pages are
# approved and the staging rehearsal has passed.
ENACTIVE_ADMISSION=list

# ENACTIVE_DEV_SIGNIN is never set here. It is a sign-in without a provider for tests, and the gateway
# refuses to start with it outside Development - set by mistake it would stop this one, not open it.
# Nor are ENACTIVE_GITHUB_BASE, ENACTIVE_GITHUB_API or ENACTIVE_GOOGLE_AUTHORITY: they move the providers
# to another host for tests, and whoever ran that host could sign in as anybody - so outside Development
# they stop the start too.

# ── what one account may use ────────────────────────────────────────────────

# The gateway's defaults, written out so they can be seen and changed without a build. Each must be a
# whole number of at least 1; anything else stops the start with the setting's name.
ENACTIVE_LIMIT_HOSTS_PER_USER=5
ENACTIVE_LIMIT_DEVICES_PER_USER=10
ENACTIVE_LIMIT_ACTIVE_RUNS_PER_USER=3
ENACTIVE_LIMIT_QUEUED_COMMANDS_PER_HOST=50
ENACTIVE_LIMIT_TASKS_PER_DAY=200
ENACTIVE_LIMIT_OPEN_INVITES_PER_USER=5
# 200 MiB of sealed content per account.
ENACTIVE_LIMIT_SEALED_BYTES_PER_USER=209715200

# ── history ─────────────────────────────────────────────────────────────────

# Days of history kept: events, notices and runs that ended longer ago are deleted hourly, with what
# they own. At least 1.
ENACTIVE_RETENTION_DAYS=30

# The backups are not configured here: backup.sh runs from cron, not from this unit, and reads
# ENACTIVE_BACKUP_KEEP_DAYS (default 30), ENACTIVE_BACKUP_DIR and ENACTIVE_BACKUP_DATABASE from its own
# environment - set them on its line in /etc/cron.d/enactive-remote if the defaults are wrong.
