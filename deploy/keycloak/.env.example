# Proposed hostname; confirm routing and HTTPS on the actual host before starting.
KEYCLOAK_ORIGIN=https://auth.enactive.app
KEYCLOAK_BOOTSTRAP_USER=bootstrap-admin
# Generate independently on the server, e.g. openssl rand -hex 32.
# Keep the populated .env file outside the repository, readable only by its operator.
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_BOOTSTRAP_PASSWORD=
